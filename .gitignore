# Secrets
.env
CLAUDE.local.md
.claude/*
!.claude/commands/
!.claude/agents/

# Runtime data
data/

# Test harness (snapshots and runs are under data/)
# Experimental prompts - baseline is the production slash command
newsroom/prompts/

# macOS
.DS_Store

# Superpowers tooling (installed artifact, not project source)
.superpowers/

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
uv.lock
# The Python worker's image builds from its lock (uv sync --frozen).
!digest/python/uv.lock
digest-cloud.db
scratch/

# CycloneDX SBOMs emitted by bin/deploy; regenerable from the pushed image digest.
/sbom/

# Rescued eval evidence is cited by docs and must travel with the tree, whatever a global
# ignore says about *.log (2a76a31 lost three of them silently).
!docs/proposed/**/*.log
digest/node_modules
digest/dist
digest/bundle
digest/sbom.cdx.json

# make judges writes the fixture-specific config here
digest/gate/judges.run.yaml
