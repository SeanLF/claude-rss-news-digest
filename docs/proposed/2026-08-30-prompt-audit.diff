+def thinking_for(model: str) -> dict[str, str] | None:
+    """Per-model thinking policy for every model call in the pipeline.
+
+    ``disabled`` for the 4.x family (Sonnet 4.6, Haiku 4.5, Opus 4.7/4.8), where
+    thinking-off was already the default -- so passing it is behaviour-preserving
+    and pins that default against an SDK change. ``None`` (the model's own default,
+    adaptive) for next-gen, where forcing it off is a documented failure mode, not
+    a neutral setting: on Claude Opus 5 a tool call can arrive as plain user-facing
+    text and silently never run, which for a stage whose entire output is one Write
+    call means no output file at all; on Claude Sonnet 5 the model is measurably
+    less willing to reach for tools with thinking off.
+
+    A stage that needs the old behaviour on a next-gen model says so explicitly in
+    its own frontmatter (`thinking: disabled`), so the choice is visible per stage
+    rather than inherited from a global constant. Lives here, in a leaf module, so
+    orchestrate / cluster_extractjoin / threads / thread_synthesis can share one
+    policy without violating the module layering in CLAUDE.md.
+    """
+    if model.startswith(("claude-sonnet-4", "claude-haiku-4", "claude-opus-4")):
+        return {"type": "disabled"}
+    return None
