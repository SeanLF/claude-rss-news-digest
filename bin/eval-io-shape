#!/bin/bash
# COHERENCE I/O-shape arms on the planted278 fixture (2026-09-21).
# Same production agent-SDK path as bin/eval-coherence, pinned to the day the fixture came from.
# Arms: tools (the shipped Read+Write loop), read-text, read-schema, inline-grep.
# Makes REAL model calls on the subscription -- opt-in, never in CI.
# Usage: bin/eval-io-shape --arm ARM [--runs N]
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
FIX="docs/proposed/coherence-planted/fixtures/planted278"
exec docker compose run --rm \
  -v "$(pwd)/$FIX:/app/eval-fixtures" \
  -v "$(pwd)/newsroom/src:/app/src" \
  -v "$(pwd)/.claude/agents:/app/.claude/agents" \
  -e PYTHONPATH=/app/src \
  --entrypoint /app/.venv/bin/python3 \
  digest-newsroom /app/src/eval_coherence.py --today 2026-08-28 "$@"
