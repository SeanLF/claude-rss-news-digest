#!/usr/bin/env python3
"""
Local CI - run all checks in Docker for reproducibility.

Usage:
    bin/ci           Run all checks (in Docker)
    bin/ci --staged  Run only the suites the staged paths reach (the pre-commit hook)
    bin/ci --fix     Auto-fix style issues
    bin/ci --full    Include pip-audit over the newsroom environment
    bin/ci --local   Run locally (skip Docker)
"""

import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

PYTHON, TS, WORKER, SCRIPTS = "python", "ts", "worker", "scripts"
ALL_SUITES = frozenset({PYTHON, TS, WORKER, SCRIPTS})

# A path narrows the run only when it clearly belongs to one suite's inputs; every other path runs
# everything. First match wins, so the shared paths sit above the prefixes that would claim them.
# test_ci_scope.py holds this table to the COPY and bind-mount lists that define each container.
_SCOPE: tuple[tuple[str, frozenset[str]], ...] = (
    # Read by more than one container (ci-ts COPY, and the newsroom tests through the symlinks
    # newsroom/ keeps to them).
    ("digest/templates/", ALL_SUITES),
    ("digest/catalogue/", ALL_SUITES),
    ("digest/src/render/fixtures/kitchensink_selections.json", ALL_SUITES),
    ("newsroom/Dockerfile.ci", ALL_SUITES),  # the ci image runs bin/ci itself
    # bin/tests/test_sbom_exceptions.py holds the SBOM gate's pins and exceptions to these
    # pyprojects and lockfiles.
    ("newsroom/pyproject.toml", frozenset({PYTHON, SCRIPTS})),
    ("newsroom/", frozenset({PYTHON})),
    ("digest/package-lock.json", frozenset({TS, SCRIPTS})),
    ("digest/python/pyproject.toml", frozenset({WORKER, TS, SCRIPTS})),
    # The ci-ts image COPYs all of digest/, python/ included.
    ("digest/python/", frozenset({WORKER, TS})),
    # bin/ops's Postgres payloads: executed in ci-ts, and read by bin/tests/test_ops.py.
    ("digest/db/ops/", frozenset({TS, SCRIPTS})),
    ("digest/", frozenset({TS})),
    # The operator scripts' own tests; the scripts they test sit in bin/ and so reach everything.
    ("bin/tests/", frozenset({SCRIPTS})),
)


def suites_for(paths: list[str]) -> frozenset[str]:
    """The suites a set of changed paths reaches. A path no rule claims reaches every suite."""
    suites: set[str] = set()
    for path in paths:
        # Container definitions are what test_ci_scope.py reads to check this table, so a change
        # to any of them must run that test (Python) as well as the suite it builds.
        name = path.rsplit("/", 1)[-1]
        if name.startswith("Dockerfile") or name == ".dockerignore" or (
            name.startswith("docker-compose") and name.endswith((".yml", ".yaml"))
        ):
            return ALL_SUITES
        for prefix, owners in _SCOPE:
            if path == prefix or (prefix.endswith("/") and path.startswith(prefix)):
                suites |= owners
                break
        else:
            return ALL_SUITES
    return frozenset(suites)


def staged_paths() -> list[str] | None:
    """Both sides of every staged change (renames split), or None when git cannot say."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--no-renames", "-z"],
        cwd=ROOT,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    return [p for p in result.stdout.decode().split("\0") if p]

# ANSI color codes
PURPLE = "\033[35m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
BOLD = "\033[1m"
RESET = "\033[0m"

ROOT = Path(__file__).resolve().parent.parent
IN_DOCKER = os.environ.get("IN_DOCKER") == "1"
QUIET = os.environ.get("CLAUDECODE") == "1"


def suite_commands(fix_mode: bool, full_mode: bool, ci_args: list[str]) -> dict[str, list[str]]:
    """The docker compose command each suite runs as, keyed by suite."""
    return {
        PYTHON: ["docker", "compose", "run", "--rm", "--build", "ci", *ci_args],
        TS: ["docker", "compose", "run", "--rm", "--build", "ci-ts", "sh", "-c", TS_CMD],
        WORKER: [
            "docker", "compose", "run", "--rm", "--build", "ci-python",
            "python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "/app/tests",
        ],
        SCRIPTS: ["docker", "compose", "run", "--rm", "--build", "ci-scripts", "sh", "-c", scripts_cmd(fix_mode)],
    }


def scripts_cmd(fix_mode: bool) -> str:
    """bin/tests: ruff, then pytest; every step runs, so one failure hides no other."""
    if fix_mode:
        lint = "ruff check --fix bin/tests; r=$?; ruff format bin/tests; f=$?"
    else:
        lint = "ruff check bin/tests; r=$?; ruff format --check bin/tests; f=$?"
    return f"{lint}; pytest -q -n auto -p no:cacheprovider bin/tests; t=$?; [ $r -eq 0 ] && [ $f -eq 0 ] && [ $t -eq 0 ]"


# Typecheck and lint (about 1 s together) run before vitest, not in its wake; every step runs, so
# one failure hides no other. A tsgolint killed for memory shows only "Error running tsgolint".
TS_CMD = "npm run typecheck; t=$?; npm run lint; l=$?; npm test; v=$?; [ $t -eq 0 ] && [ $l -eq 0 ] && [ $v -eq 0 ]"

SUITE_NAMES = {
    PYTHON: "Python CI",
    TS: "TypeScript CI",
    WORKER: "Python worker CI",
    SCRIPTS: "bin/ scripts CI",
}


def run_in_docker() -> int:
    """Run CI via docker compose, one container per suite, all in parallel."""
    args = sys.argv[1:]
    fix_mode = "--fix" in args
    full_mode = "--full" in args
    # Pass --fix/--full through so the Python CI container fixes or runs the dependency audit.
    ci_args = [a for a in args if a != "--staged"]

    suites = ALL_SUITES
    if "--staged" in args:
        paths = staged_paths()
        suites = ALL_SUITES if paths is None else suites_for(paths)
    if not suites:
        print(f"{GREEN}No staged paths reach a suite; nothing to check{RESET}")
        return 0
    skipped = sorted(ALL_SUITES - suites)
    print(f"{BOLD}{PURPLE}Running CI in Docker: {', '.join(sorted(suites))}{RESET}")
    if skipped:
        print(f"{YELLOW}Not reached by the staged paths: {', '.join(skipped)}{RESET}")
    print()

    # In quiet mode, capture output and only show on failure
    capture = {"stdout": subprocess.PIPE, "stderr": subprocess.STDOUT} if QUIET else {}
    commands = suite_commands(fix_mode, full_mode, ci_args)
    start = time.monotonic()
    procs = {s: subprocess.Popen(commands[s], cwd=ROOT, **capture) for s in sorted(suites)}

    def wait(suite: str) -> tuple[bytes | None, float]:
        out = procs[suite].communicate()[0]
        return out, time.monotonic() - start

    with ThreadPoolExecutor(len(procs)) as pool:
        results = dict(zip(procs, pool.map(wait, procs)))

    for suite, (out, secs) in results.items():
        code = procs[suite].returncode
        print(f"  {SUITE_NAMES[suite]}: exit {code} in {secs:.0f}s")
        if code != 0:
            print(f"\n{RED}{SUITE_NAMES[suite]} failed (exit {code}){RESET}")
            if out:
                print(out.decode(errors="replace"))

    failed = [p.returncode for p in procs.values() if p.returncode != 0]
    if not failed and QUIET:
        print(f"{GREEN}CI passed{RESET}")
    return failed[0] if failed else 0


def run_step(name: str, cmd: list[str], cwd: Path | None = None) -> bool:
    """Run a CI step and return success status."""
    if QUIET:
        result = subprocess.run(cmd, cwd=cwd or ROOT, capture_output=True)
        passed = result.returncode == 0
        status = f"{GREEN}pass{RESET}" if passed else f"{RED}FAIL{RESET}"
        print(f"  {status}  {name}")
        if not passed:
            output = (result.stdout or b"") + (result.stderr or b"")
            if output:
                print(output.decode(errors="replace"))
        return passed

    print(f"\n{BOLD}{PURPLE}=== {name} ==={RESET}")
    result = subprocess.run(cmd, cwd=cwd or ROOT)
    passed = result.returncode == 0
    print(f"{GREEN}Passed{RESET}" if passed else f"{RED}Failed{RESET}")
    return passed


def py_cmd(tool: str, *args: str) -> list[str]:
    """Build command to run a Python tool (via python -m in Docker)."""
    if IN_DOCKER:
        return ["python3", "-m", tool, *args]
    return [tool, *args]


def check_tool(tool: str) -> bool:
    """Check if a tool is available."""
    try:
        subprocess.run(py_cmd(tool, "--version"), capture_output=True, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def run_checks(fix_mode: bool, full_mode: bool) -> int:
    """Run all CI checks."""
    # Verify tools available
    tools = ["ruff", "mypy", "bandit", "pytest"]
    missing = [t for t in tools if not check_tool(t)]
    if missing:
        print(f"{YELLOW}Missing tools: {', '.join(missing)}{RESET}")
        print("Install with: uv pip install ruff mypy bandit pytest")
        return 1

    # Define steps
    steps: list[tuple[str, list[str], Path | None]] = []

    # Python checks - target newsroom/src/ and newsroom/tests/
    ruff_config = ["--config", "newsroom/pyproject.toml"]
    if fix_mode:
        steps.append(("Style: Python (fix)", py_cmd("ruff", "check", "--fix", *ruff_config, "newsroom/src/", "newsroom/tests/", "newsroom/tools/"), None))
        steps.append(("Format: Python", py_cmd("ruff", "format", *ruff_config, "newsroom/src/", "newsroom/tests/", "newsroom/tools/"), None))
    else:
        steps.append(("Style: Python", py_cmd("ruff", "check", *ruff_config, "newsroom/src/", "newsroom/tests/", "newsroom/tools/"), None))
        steps.append(("Format: Python (check)", py_cmd("ruff", "format", "--check", *ruff_config, "newsroom/src/", "newsroom/tests/", "newsroom/tools/"), None))

    steps.append(("Types: Python", py_cmd("mypy", "--config-file", "newsroom/pyproject.toml", "newsroom/src/run.py", "newsroom/src/merge.py", "newsroom/src/repair.py", "newsroom/src/schema.py"), None))
    steps.append(("Security: Python", py_cmd("bandit", "-c", "newsroom/pyproject.toml", "-r", "newsroom/src/run.py", "newsroom/src/merge.py", "newsroom/src/repair.py", "newsroom/src/schema.py", "-q"), None))

    # Dependency vulnerability scan (pip-audit, only with --full).
    # Audits the installed environment (prod pins lxml, floats the rest to latest). pip-audit is
    # not baked into the CI image; install it inline into the system env the same way the image
    # installs its other tools (uv pip install --system), then run it via `python3 -m`.
    if full_mode:
        pip_audit = ["python3", "-m", "pip_audit"]

        def has_pip_audit() -> bool:
            return subprocess.run([*pip_audit, "--version"], capture_output=True).returncode == 0

        if not has_pip_audit():
            subprocess.run(
                ["uv", "pip", "install", "--system", "--break-system-packages", "pip-audit"],
                capture_output=True,
            )
        if has_pip_audit():
            steps.append(("Security: Python deps", pip_audit, None))
        else:
            print(f"{YELLOW}Skipping pip-audit (could not install pip-audit){RESET}")

    # Tests (if newsroom/tests/ exists)
    if (ROOT / "newsroom" / "tests").exists():
        # pytest-xdist is baked into the CI image (newsroom/Dockerfile.ci), not a local install.
        shard = ["-n", "auto"] if IN_DOCKER else []
        steps.append(("Tests: Python", py_cmd("pytest", "-v", *shard, "newsroom/tests/"), None))

    # Run all steps
    results = [run_step(name, cmd, cwd) for name, cmd, cwd in steps]

    # Summary
    print()
    passed, total = sum(results), len(results)
    success = all(results)

    color = GREEN if success else RED
    status = "passed" if success else "failed"
    print(f"{color}CI {status} ({passed}/{total}){RESET}")
    return 0 if success else 1


def main() -> int:
    fix_mode = "--fix" in sys.argv
    full_mode = "--full" in sys.argv
    local_mode = "--local" in sys.argv

    # Re-exec in Docker unless --local or already in Docker
    if not IN_DOCKER and not local_mode:
        return run_in_docker()

    return run_checks(fix_mode, full_mode)


if __name__ == "__main__":
    sys.exit(main())
