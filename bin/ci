#!/usr/bin/env python3
"""
Local CI - run all checks in Docker for reproducibility.

Usage:
    bin/ci           Run all checks (in Docker)
    bin/ci --fix     Auto-fix style issues
    bin/ci --full    Include cargo audit (slow, runs by default in deploy)
    bin/ci --local   Run locally (skip Docker)
"""

import os
import subprocess
import sys
from pathlib import Path

# ANSI color codes
PURPLE = "\033[35m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
BOLD = "\033[1m"
RESET = "\033[0m"

ROOT = Path(__file__).resolve().parent.parent
IN_DOCKER = os.environ.get("IN_DOCKER") == "1"
QUIET = os.environ.get("CLAUDECODE") == "1"


def run_in_docker() -> int:
    """Run CI via docker compose (Python + Rust in parallel)."""
    print(f"{BOLD}{PURPLE}Running CI in Docker...{RESET}\n")

    args = sys.argv[1:]
    fix_mode = "--fix" in args
    full_mode = "--full" in args
    # Pass --full through so the Python CI container runs the dependency audit (pip-audit).
    ci_args = list(args)

    # In quiet mode, capture output and only show on failure
    capture = {"stdout": subprocess.PIPE, "stderr": subprocess.STDOUT} if QUIET else {}

    # Start Python CI
    py_proc = subprocess.Popen(
        ["docker", "compose", "run", "--rm", "--build", "ci", *ci_args],
        cwd=ROOT,
        **capture,
    )

    # Start Rust CI (if circulation exists)
    rust_proc = None
    circulation = ROOT / "circulation"
    if circulation.exists():
        fmt_cmd = "cargo fmt" if fix_mode else "cargo fmt --check"
        rust_parts = [fmt_cmd, "cargo clippy -- -D warnings", "cargo test"]
        if full_mode:
            rust_parts.insert(2, "cargo audit")
        cmd = " && ".join(rust_parts)
        rust_proc = subprocess.Popen(
            ["docker", "compose", "run", "--rm", "ci-rust", cmd],
            cwd=ROOT,
            **capture,
        )

    # Wait for both
    py_out = py_proc.communicate()[0]
    py_rc = py_proc.returncode
    rust_out = rust_proc.communicate()[0] if rust_proc else None
    rust_rc = rust_proc.returncode if rust_proc else 0

    if py_rc != 0:
        print(f"\n{RED}Python CI failed (exit {py_rc}){RESET}")
        if py_out:
            print(py_out.decode(errors="replace"))
    if rust_rc != 0:
        print(f"\n{RED}Rust CI failed (exit {rust_rc}){RESET}")
        if rust_out:
            print(rust_out.decode(errors="replace"))

    if py_rc == 0 and rust_rc == 0 and QUIET:
        print(f"{GREEN}CI passed{RESET}")

    if py_rc != 0:
        return py_rc
    return rust_rc


def run_step(name: str, cmd: list[str], cwd: Path | None = None) -> bool:
    """Run a CI step and return success status."""
    if QUIET:
        result = subprocess.run(cmd, cwd=cwd or ROOT, capture_output=True)
        passed = result.returncode == 0
        status = f"{GREEN}pass{RESET}" if passed else f"{RED}FAIL{RESET}"
        print(f"  {status}  {name}")
        if not passed:
            output = (result.stdout or b"") + (result.stderr or b"")
            if output:
                print(output.decode(errors="replace"))
        return passed

    print(f"\n{BOLD}{PURPLE}=== {name} ==={RESET}")
    result = subprocess.run(cmd, cwd=cwd or ROOT)
    passed = result.returncode == 0
    print(f"{GREEN}Passed{RESET}" if passed else f"{RED}Failed{RESET}")
    return passed


def py_cmd(tool: str, *args: str) -> list[str]:
    """Build command to run a Python tool (via python -m in Docker)."""
    if IN_DOCKER:
        return ["python3", "-m", tool, *args]
    return [tool, *args]


def check_tool(tool: str) -> bool:
    """Check if a tool is available."""
    try:
        subprocess.run(py_cmd(tool, "--version"), capture_output=True, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def run_checks(fix_mode: bool, full_mode: bool) -> int:
    """Run all CI checks."""
    # Verify tools available
    tools = ["ruff", "mypy", "bandit", "pytest"]
    missing = [t for t in tools if not check_tool(t)]
    if missing:
        print(f"{YELLOW}Missing tools: {', '.join(missing)}{RESET}")
        print("Install with: uv pip install ruff mypy bandit pytest")
        return 1

    # Define steps
    steps: list[tuple[str, list[str], Path | None]] = []

    # Python checks - target newsroom/src/ and newsroom/tests/
    ruff_config = ["--config", "newsroom/pyproject.toml"]
    if fix_mode:
        steps.append(("Style: Python (fix)", py_cmd("ruff", "check", "--fix", *ruff_config, "newsroom/src/", "newsroom/tests/"), None))
        steps.append(("Format: Python", py_cmd("ruff", "format", *ruff_config, "newsroom/src/", "newsroom/tests/"), None))
    else:
        steps.append(("Style: Python", py_cmd("ruff", "check", *ruff_config, "newsroom/src/", "newsroom/tests/"), None))
        steps.append(("Format: Python (check)", py_cmd("ruff", "format", "--check", *ruff_config, "newsroom/src/", "newsroom/tests/"), None))

    steps.append(("Types: Python", py_cmd("mypy", "--config-file", "newsroom/pyproject.toml", "newsroom/src/run.py", "newsroom/src/merge.py", "newsroom/src/repair.py", "newsroom/src/schema.py"), None))
    steps.append(("Security: Python", py_cmd("bandit", "-c", "newsroom/pyproject.toml", "-r", "newsroom/src/run.py", "newsroom/src/merge.py", "newsroom/src/schema.py", "-q"), None))

    # Dependency vulnerability scan (pip-audit, only with --full) -- mirrors Rust's cargo audit.
    # Audits the installed environment (prod pins lxml, floats the rest to latest). pip-audit is
    # not baked into the CI image; install it inline into the system env the same way the image
    # installs its other tools (uv pip install --system), then run it via `python3 -m`.
    if full_mode:
        pip_audit = ["python3", "-m", "pip_audit"]

        def has_pip_audit() -> bool:
            return subprocess.run([*pip_audit, "--version"], capture_output=True).returncode == 0

        if not has_pip_audit():
            subprocess.run(
                ["uv", "pip", "install", "--system", "--break-system-packages", "pip-audit"],
                capture_output=True,
            )
        if has_pip_audit():
            steps.append(("Security: Python deps", pip_audit, None))
        else:
            print(f"{YELLOW}Skipping pip-audit (could not install pip-audit){RESET}")

    # Tests (if newsroom/tests/ exists)
    if (ROOT / "newsroom" / "tests").exists():
        steps.append(("Tests: Python", py_cmd("pytest", "-v", "newsroom/tests/"), None))

    # Rust checks (local only - no cargo in Docker image)
    circulation = ROOT / "circulation"
    if not IN_DOCKER and circulation.exists():
        try:
            subprocess.run(["cargo", "--version"], capture_output=True, check=True)
            # Format
            if fix_mode:
                steps.append(("Format: Rust", ["cargo", "fmt"], circulation))
            else:
                steps.append(("Format: Rust (check)", ["cargo", "fmt", "--check"], circulation))
            # Lint
            steps.append(("Style: Rust", ["cargo", "clippy", "--", "-D", "warnings"], circulation))
            # Security (cargo-audit, only with --full)
            if full_mode:
                audit_check = subprocess.run(["cargo", "audit", "--version"], capture_output=True)
                if audit_check.returncode == 0:
                    steps.append(("Security: Rust", ["cargo", "audit"], circulation))
                else:
                    print(f"{YELLOW}Skipping cargo audit (not installed: cargo install cargo-audit){RESET}")
            # Tests
            steps.append(("Tests: Rust", ["cargo", "test"], circulation))
        except (subprocess.CalledProcessError, FileNotFoundError):
            print(f"{YELLOW}Skipping Rust checks (cargo not found){RESET}")

    # Run all steps
    results = [run_step(name, cmd, cwd) for name, cmd, cwd in steps]

    # Summary
    print()
    passed, total = sum(results), len(results)
    success = all(results)

    color = GREEN if success else RED
    status = "passed" if success else "failed"
    print(f"{color}CI {status} ({passed}/{total}){RESET}")
    return 0 if success else 1


def main() -> int:
    fix_mode = "--fix" in sys.argv
    full_mode = "--full" in sys.argv
    local_mode = "--local" in sys.argv

    # Re-exec in Docker unless --local or already in Docker
    if not IN_DOCKER and not local_mode:
        return run_in_docker()

    return run_checks(fix_mode, full_mode)


if __name__ == "__main__":
    sys.exit(main())
