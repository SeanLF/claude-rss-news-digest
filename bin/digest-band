#!/bin/bash
# The new system's same-day curation band (spec §7.4): N forced re-runs of one closed day through
# the TypeScript workflow on local Temporal, against a scratch copy of the database. Each rep is
# approved at start so the pre-broadcast hold is not counted; wall time is the workflow's own
# start-to-close from Temporal, cost the sum of that rep's per-stage usage rows. Model calls on the
# subscription: about $4 and 15 min per rep. Nothing is deleted: a fresh stamped copy of the DB and
# a fresh result directory per band.
# Usage: bin/digest-band --run 300 --date 2026-09-18 [--reps 3]
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
run="" date="" reps=3
while [ $# -gt 0 ]; do
  case "$1" in
    --run) run="$2"; shift 2 ;;
    --date) date="$2"; shift 2 ;;
    --reps) reps="$2"; shift 2 ;;
    *) echo "usage: bin/digest-band --run N --date YYYY-MM-DD [--reps 3]" >&2; exit 2 ;;
  esac
done
[ -n "$run" ] && [ -n "$date" ] || { echo "usage: bin/digest-band --run N --date YYYY-MM-DD [--reps 3]" >&2; exit 2; }

stamp=$(date -u +%Y%m%dT%H%M%SZ)
band="data/digest-band/run${run}/${stamp}"
db="data/digest-band-${stamp}.db"
mkdir -p "$band"
cp data/digest.db "$db"
echo "band: $band  db: $db"

compose=(docker compose --env-file .env -f digest/compose.temporal.yml)
temporal() { docker run --rm --network digest_default temporalio/admin-tools:1.32.0 temporal --address temporal:7233 "$@"; }
export DIGEST_DB_PATH="/app/${db}"
"${compose[@]}" up -d --build >/dev/null 2>&1
sleep 15

for i in $(seq 0 $((reps - 1))); do
  since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo "rep $i: start $since"
  "${compose[@]}" run --rm digest-worker node dist/cli/start.js "$date" --resume "$run" --force > "$band/rep${i}.start.log" 2>&1 &
  starter=$!
  # Wait for THIS rep's execution to be running (a describe can still find the previous, closed one).
  running=""
  for _ in $(seq 1 60); do
    if temporal workflow describe -w "digest-${date}" -o json 2>/dev/null | grep -q '"WORKFLOW_EXECUTION_STATUS_RUNNING"'; then running=1; break; fi
    sleep 2
  done
  [ -n "$running" ] || { echo "rep $i: workflow never started" >&2; kill "$starter" 2>/dev/null || true; exit 1; }
  temporal workflow signal -w "digest-${date}" --name approve --input '{"decision":"approve"}' >/dev/null
  wait "$starter" || { echo "rep $i: workflow failed, see $band/rep${i}.start.log" >&2; }
  temporal workflow describe -w "digest-${date}" -o json > "$band/rep${i}.describe.json" 2>/dev/null || true
  "${compose[@]}" logs --since "$since" --no-log-prefix digest-worker > "$band/rep${i}.worker.log" 2>&1
  tail -1 "$band/rep${i}.start.log"
done

python3 - "$band" "$run" "$reps" <<'PY'
import json, re, sys
from datetime import datetime
from pathlib import Path
band, run, reps = Path(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
def ts(s): return datetime.fromisoformat(s.replace("Z", "+00:00"))
out = {"run": run, "reps": reps, "cost_usd": [], "wall_s": [], "stories": [], "per_stage_usd": []}
for i in range(reps):
    rows = [json.loads(m)["usage"] for m in re.findall(r'\{"usage":\{.*?\}\}', (band / f"rep{i}.worker.log").read_text())]
    stages = {}
    for r in rows: stages[r["stage"]] = round(stages.get(r["stage"], 0) + r["costUsd"], 4)
    d = json.loads((band / f"rep{i}.describe.json").read_text() or "{}")
    info = d.get("workflowExecutionInfo", {})
    wall = (ts(info["closeTime"]) - ts(info["startTime"])).total_seconds() if info.get("closeTime") else None
    result = [l for l in (band / f"rep{i}.start.log").read_text().splitlines() if l.startswith("{")]
    out["cost_usd"].append(round(sum(stages.values()), 4))
    out["wall_s"].append(round(wall, 1) if wall is not None else None)
    out["stories"].append(json.loads(result[-1]).get("stories") if result else None)
    out["per_stage_usd"].append(stages)
(band / "summary.json").write_text(json.dumps(out, indent=2))
print(json.dumps({k: out[k] for k in ("cost_usd", "wall_s", "stories")}))
PY
