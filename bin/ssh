#!/bin/bash
# SSH to the news-digest server
# Usage: bin/ssh [COMMAND...]
#
# With no arguments, opens an interactive shell; with arguments, runs the command remotely.
# The box is reached by its tailnet name; DIGEST_SSH_HOST (.env) overrides it.
set -e

cd "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")"
if [ -f .env ]; then
  # shellcheck source=/dev/null
  source .env
fi

exec ssh "${DIGEST_SSH_HOST:-root@seanfloyd-hetzner}" "$@"
