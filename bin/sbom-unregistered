#!/usr/bin/env python3
"""Packages an image installs from a URL or git instead of a registry, which the SBOM audit cannot see.

usage: bin/sbom-unregistered SBOM.cdx.json [Cargo.lock|package-lock.json ...]

still_active audits by purl, and a URL install keeps its registry purl: the googlenewsdecoder fork
reads as pkg:pypi/googlenewsdecoder@0.2.0, so the audit reports PyPI's googlenewsdecoder, another
package. syft records a Python URL install as a `vcs` reference, and that is what this reads. It
reports Cargo and npm git dependencies with no such reference, so their lockfiles are read too:
Cargo.lock `source = "git+..."`, package-lock `resolved` values starting `git+` or `github:`, or
fetched from any host but registry.npmjs.org.

Exit 0: none, or only listed exceptions (each printed as unaudited). Exit 1: an unlisted one.
Exit 2: an input could not be read. Tested by bin/tests/test_sbom_exceptions.py.
"""

import json
import sys
from urllib.parse import urlparse

import tomllib

# Source -> why it ships unaudited. Every URL pin in a pyproject and every git source in a lockfile
# is here, and nothing else is (tested).
EXCEPTIONS = {
    "https://github.com/SeanLF/google-news-url-decoder/archive/4860ab58e633c08d86fded1af69ae249ab6de2cb.tar.gz": (
        "the googlenewsdecoder fork newsroom's gnews.py calls, until the Python pipeline retires at the "
        "cut-over (the digest decodes with gnews-decoder from npm). Maintained by Sean alone; review it by hand."
    ),
}

GIT_PREFIXES = ("git+", "github:")
# A tarball from any other host is as unaudited as a git dependency. In-repo paths (`link`) have no scheme.
NPM_REGISTRY = "registry.npmjs.org"


def lockfile_sources(paths: list[str]) -> list[tuple[str, str]]:
    """(package, source) for every git or off-registry dependency in the given Cargo.lock and package-lock.json files."""
    found: list[tuple[str, str]] = []
    for path in paths:
        with open(path, "rb") as f:
            raw = f.read()
        if path.endswith(".lock"):
            for p in tomllib.loads(raw.decode("utf-8")).get("package", []):
                if str(p.get("source", "")).startswith("git+"):
                    found.append((p["name"], p["source"]))
        else:
            for key, p in (json.loads(raw).get("packages") or {}).items():
                resolved = str(p.get("resolved", ""))
                remote = urlparse(resolved).scheme in ("http", "https")
                if resolved.startswith(GIT_PREFIXES) or (
                    remote and urlparse(resolved).hostname != NPM_REGISTRY
                ):
                    found.append(
                        (p.get("name") or key.rsplit("node_modules/", 1)[-1], resolved)
                    )
    return found


def _report(name: str, source: str, purl: str | None = None) -> bool:
    if source in EXCEPTIONS:
        another = f" ({purl} is another package)" if purl else ""
        print(
            f"EXCEPTION: {name} ships from {source} and is NOT audited by still_active{another}: {EXCEPTIONS[source]}",
            file=sys.stderr,
        )
        return True
    print(
        f"UNAUDITED: {name} ships from {source}, which no registry audit covers; pin a registry "
        f"release or add a named exception to bin/sbom-unregistered",
        file=sys.stderr,
    )
    return False


def main(sbom: str, lockfiles: list[str]) -> int:
    try:
        with open(sbom, encoding="utf-8") as f:
            components = json.load(f)["components"]
        locked = lockfile_sources(lockfiles)
    except (OSError, ValueError, KeyError, TypeError) as e:
        print(f"sbom-unregistered: cannot read an input: {e}", file=sys.stderr)
        return 2
    ok = True
    for c in components:
        for ref in c.get("externalReferences") or []:
            if ref.get("type") == "vcs":
                ok &= _report(c.get("name", "?"), ref.get("url", ""), c.get("purl"))
    for name, source in locked:
        ok &= _report(name, source)
    return 0 if ok else 1


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        sys.exit(2)
    sys.exit(main(sys.argv[1], sys.argv[2:]))
