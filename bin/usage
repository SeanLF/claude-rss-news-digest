#!/bin/bash
# Token usage from the local clone of the product database (bin/db-clone fills it; bin/psql
# reaches it), read-only.
#
# Usage:
#   bin/usage              # Per-stage rows for every finished run, newest first, and a total
#   bin/usage daily        # Daily totals

set -euo pipefail

PSQL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/psql"
export PGOPTIONS="-c default_transaction_read_only=on"

# A run's calls count once it ended, completed with any outcome or failed: a held-out, rejected or
# failed run spent the same tokens. Only a run still running is left out.
case "${1:-detail}" in
  detail)
    "$PSQL" -q -v ON_ERROR_STOP=1 -P footer=off -c "
      WITH recent AS (
        SELECT
          (r.started_at AT TIME ZONE 'UTC')::date AS date,
          r.started_at,
          mc.stage,
          mc.request_model AS model,
          mc.input_tokens AS input,
          mc.output_tokens AS output,
          mc.cache_creation_input_tokens AS cache_w,
          mc.cache_read_input_tokens AS cache_r,
          mc.api_cost_usd AS cost_usd,
          mc.id
        FROM model_calls mc
        JOIN runs r ON r.id = mc.run_id
        WHERE r.status <> 'running'
      ), fmt AS (
        SELECT date::text AS date, stage, model, input, output, cache_w, cache_r, cost_usd, 0 AS total_row, started_at, id
        FROM recent
        UNION ALL
        SELECT 'TOTAL', '', '', SUM(input), SUM(output), SUM(cache_w), SUM(cache_r), SUM(cost_usd), 1, NULL, NULL
        FROM recent
      )
      SELECT date, stage, model,
        CASE WHEN input   >= 1000000 THEN round(input   / 1000000.0, 1) || 'M' WHEN input   >= 1000 THEN round(input   / 1000.0) || 'K' ELSE input::text   END AS input,
        CASE WHEN output  >= 1000000 THEN round(output  / 1000000.0, 1) || 'M' WHEN output  >= 1000 THEN round(output  / 1000.0) || 'K' ELSE output::text  END AS output,
        CASE WHEN cache_w >= 1000000 THEN round(cache_w / 1000000.0, 1) || 'M' WHEN cache_w >= 1000 THEN round(cache_w / 1000.0) || 'K' ELSE cache_w::text END AS cache_w,
        CASE WHEN cache_r >= 1000000 THEN round(cache_r / 1000000.0, 1) || 'M' WHEN cache_r >= 1000 THEN round(cache_r / 1000.0) || 'K' ELSE cache_r::text END AS cache_r,
        '\$' || to_char(cost_usd, 'FM999999990.00') AS cost
      FROM fmt
      ORDER BY total_row, started_at DESC, stage COLLATE \"C\", id;
    "
    ;;
  daily)
    "$PSQL" -q -v ON_ERROR_STOP=1 -P footer=off -c "
      WITH daily AS (
        SELECT
          (r.started_at AT TIME ZONE 'UTC')::date AS date,
          COUNT(DISTINCT mc.stage) AS stages,
          SUM(mc.input_tokens + mc.output_tokens + mc.cache_creation_input_tokens + mc.cache_read_input_tokens) AS total_tokens,
          SUM(mc.api_cost_usd) AS cost_usd
        FROM model_calls mc
        JOIN runs r ON r.id = mc.run_id
        WHERE r.status <> 'running'
        GROUP BY 1
      ), fmt AS (
        SELECT date::text AS date, stages, total_tokens, cost_usd, 0 AS total_row FROM daily
        UNION ALL
        SELECT 'TOTAL', SUM(stages), SUM(total_tokens), SUM(cost_usd), 1 FROM daily
      )
      SELECT date, stages,
        CASE WHEN total_tokens >= 1000000 THEN round(total_tokens / 1000000.0, 1) || 'M' WHEN total_tokens >= 1000 THEN round(total_tokens / 1000.0) || 'K' ELSE total_tokens::text END AS total_tokens,
        '\$' || to_char(cost_usd, 'FM999999990.00') AS total_cost
      FROM fmt
      ORDER BY total_row, date DESC;
    "
    ;;
  *)
    echo "Usage: bin/usage [detail|daily]"
    exit 1
    ;;
esac
