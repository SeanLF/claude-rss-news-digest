#!/usr/bin/env python3
"""Hold the Postgres analytics queries to their SQLite originals on the same data.

Usage:
  bin/analytics-parity SQLITE_FILE [--ref REF] [--runs 30,400] [NAME...]

SQLITE_FILE is a legacy digest.db; the Postgres side is the database bin/import-legacy built from
it, reached through bin/psql ($DIGEST_CLONE_URL, $DIGEST_CLONE_NETWORK). The originals are read
from git at REF (default 44a8dfe, the last commit with the SQLite queries) and run by the sqlite3
CLI read-only. Each query runs at every --runs window and prints EQUAL, SAME ROWS (order differs:
ties in ORDER BY), or DIFF with the differing cells. Numbers compare as numbers, so 12 and 12.0
are equal; column names are not compared, because the port renames some. Exit status is the
number of DIFFs. Retires with the SQLite file at the cut-over.
"""

from __future__ import annotations

import argparse
import csv
import io
import os
import subprocess
import sys
from decimal import Decimal, InvalidOperation
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def sqlite_rows(db: str, sql: str, runs: int) -> list[list[str]]:
    script = f".param set :runs {runs}\n.param set :days 30\n.param set :limit 40\n{sql}\n"
    out = subprocess.run(
        ["sqlite3", "-readonly", "-csv", db],
        input=script,
        text=True,
        capture_output=True,
        check=True,
    ).stdout
    return list(csv.reader(io.StringIO(out)))


def postgres_rows(sql: str, runs: int) -> list[list[str]]:
    argv = [
        str(ROOT / "bin" / "psql"),
        "-q",
        "-v",
        "ON_ERROR_STOP=1",
        "-v",
        f"runs={runs}",
        "-v",
        "days=30",
        "-v",
        "limit=40",
        "--csv",
        "-t",
        "-f",
        "-",
    ]
    env = {**os.environ, "PGOPTIONS": "-c default_transaction_read_only=on"}
    proc = subprocess.run(argv, input=sql, text=True, capture_output=True, env=env)
    if proc.returncode:
        raise SystemExit(proc.stderr)
    return list(csv.reader(io.StringIO(proc.stdout)))


def same(a: str, b: str) -> bool:
    if a == b:
        return True
    try:
        return Decimal(a) == Decimal(b)
    except InvalidOperation:
        return False


def rows_equal(x: list[list[str]], y: list[list[str]]) -> bool:
    return len(x) == len(y) and all(len(r) == len(s) and all(map(same, r, s, strict=True)) for r, s in zip(x, y, strict=True))


def canonical(rows: list[list[str]]) -> list[list[str]]:
    def key(cell: str) -> str:
        try:
            return str(Decimal(cell).normalize())
        except InvalidOperation:
            return cell

    return sorted([[key(c) for c in r] for r in rows])


def main() -> int:
    ap = argparse.ArgumentParser(prog="bin/analytics-parity")
    ap.add_argument("sqlite_file")
    ap.add_argument("names", nargs="*")
    ap.add_argument("--ref", default="44a8dfe")
    ap.add_argument("--runs", default="30,400")
    ap.add_argument("--max-lines", type=int, default=12, help="differing rows printed per DIFF")
    args = ap.parse_args()
    names = args.names or sorted(p.stem for p in (ROOT / "analytics" / "queries").glob("*.sql"))
    diffs = 0
    for name in names:
        old = subprocess.run(
            [
                "git",
                "-C",
                str(ROOT),
                "show",
                f"{args.ref}:analytics/queries/{name}.sql",
            ],
            text=True,
            capture_output=True,
            check=True,
        ).stdout
        new = (ROOT / "analytics" / "queries" / f"{name}.sql").read_text()
        for runs in (int(n) for n in args.runs.split(",")):
            a, b = sqlite_rows(args.sqlite_file, old, runs), postgres_rows(new, runs)
            if rows_equal(a, b):
                verdict = "EQUAL"
            elif canonical(a) == canonical(b):
                verdict = "SAME ROWS (order differs)"
            else:
                verdict = "DIFF"
                diffs += 1
            print(f"{name} runs={runs}: {verdict} ({len(a)} vs {len(b)} rows)")
            if verdict == "DIFF":
                lines = []
                for i, (r, s) in enumerate(zip(a, b, strict=False)):
                    cells = [(j, c, d) for j, (c, d) in enumerate(zip(r, s, strict=False)) if not same(c, d)]
                    if cells:
                        lines.append(f"  row {i}: " + "; ".join(f"col {j}: {c!r} -> {d!r}" for j, c, d in cells[:6]))
                lines += [f"  only in SQLite: {r}" for r in a[len(b) :]]
                lines += [f"  only in Postgres: {s}" for s in b[len(a) :]]
                print("\n".join(lines[: args.max_lines]))
                if len(lines) > args.max_lines:
                    print(f"  ... {len(lines) - args.max_lines} more differing rows")
    return diffs


if __name__ == "__main__":
    sys.exit(main())
