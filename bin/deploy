#!/bin/bash
# Deploy news-digest infrastructure
# Usage: bin/deploy [--skip-build] [--skip-web-check] [--skip-sbom-audit] [-y|--yes] [--dry-run] [--force]
#                   [--rollback=deploy/<timestamp>]
#
# Builds and pushes Docker images, then applies Terraform
#
# Options:
#   --skip-build  Skip Docker image build/push
#   --skip-web-check  Skip the a11y/Lighthouse gate on the rendered pages
#   --skip-sbom-audit Skip the still_active vulnerability gate on the generated SBOMs
#   -y, --yes     Skip confirmation prompt
#   --dry-run     Show what would be done without making changes
#   --force       Deploy inside the Temporal run window (12:00-13:45 Europe/Paris) when the Temporal pipeline is live,
#                 or while a digest workflow is running (staged or temporal)
#   --rollback=TAG  Deploy the images an earlier deploy tag recorded, by digest, through every gate
#                 above, without building or migrating. The box keeps the last 3 images of each
#                 repository (keep_images_on_box), so this needs no registry for them. List the
#                 tags with: git tag -n3 -l 'deploy/*'
#
# Required environment variables (set in .env):
#   REGISTRY  - Docker registry URL (e.g., registry.example.com:5000)
#   INFRA_DIR - Path to infrastructure repo containing bin/tf

set -e

# ============================================
# Constants
# ============================================

TAILSCALE_TIMEOUT=30
TAILSCALE_MARKER="/tmp/.tailscale-started-by-news-digest-deploy"
DOCKER_CHECK_TIMEOUT=5

# Builds, SBOM target choice and terraform vars all key off these; spelling one out separately
# desyncs the others silently.
SERVICE_CIRCULATION="digest-circulation"
SERVICE_NEWSROOM="digest-newsroom"
# The Temporal pipeline's two workers, TypeScript and Python. Terraform names them too
# (news_digest_worker_image_name, news_digest_python_image_name); a rename here without one there pins a digest to a repository
# terraform never pulls.
SERVICE_WORKER="digest-worker"
SERVICE_PYTHON="digest-python"
# The TypeScript site, digest/Dockerfile's `site` target; terraform's news_digest_site_image_name.
SERVICE_SITE="digest-site"

# Rendered on the box by terraform (news-digest-temporal.tf): pauses the daily Temporal schedule,
# or re-derives its pause state from which pipeline is live.
SCHEDULE_CTL="/opt/news-digest/bin/digest-schedule"
SCHEDULE_BOOTSTRAP_UNIT="news-digest-temporal-bootstrap.service"

SBOM_DIR="sbom"
DIGEST_DIR=""

# ============================================
# Parse arguments
# ============================================

SKIP_BUILD=false
SKIP_WEB_CHECK=false
SKIP_SBOM_AUDIT=false
AUTO_APPROVE=false
DRY_RUN=false
FORCE=false
ROLLBACK_TAG=""

for arg in "$@"; do
  case $arg in
    --skip-build) SKIP_BUILD=true ;;
    --skip-web-check) SKIP_WEB_CHECK=true ;;
    --skip-sbom-audit) SKIP_SBOM_AUDIT=true ;;
    -y|--yes) AUTO_APPROVE=true ;;
    --dry-run) DRY_RUN=true ;;
    --force) FORCE=true ;;
    --rollback=*) ROLLBACK_TAG=${arg#--rollback=} ;;
  esac
done

# ============================================
# Logging helpers
# ============================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/log.sh
source "$SCRIPT_DIR/lib/log.sh"

dry_run_skip() {
  [[ $DRY_RUN == true ]] && log_info "[dry-run] Would run: $1" && return 0
  return 1
}

run_or_skip() {
  dry_run_skip "$1" && return 0
  shift
  "$@"
}

# `timeout` bounds the time BETWEEN probes, in seconds: the loop cannot interrupt a probe in
# flight, so the wall clock is `timeout` plus one probe's own duration. It used to count
# attempts instead, which agreed with a clock only while every probe returned instantly --
# true of `docker info` and `tailscale status`, not of a curl with --max-time, where "60"
# quietly meant minutes and the reported elapsed time was not the elapsed time.
#
# An empty timeout would collapse the argument, shift the probe away, and report success
# without ever running it, so it is refused rather than trusted.
wait_for_condition() {
  local description="$1" timeout="$2" start=$SECONDS
  shift 2

  if ! [[ $timeout =~ ^[0-9]+$ ]]; then
    log_error "wait_for_condition: timeout must be a whole number of seconds, got '$timeout'"
    return 1
  fi

  while ! "$@" &>/dev/null && (( SECONDS - start < timeout )); do
    sleep 1
  done

  "$@" &>/dev/null && log_success "$description ($((SECONDS - start))s)" && return 0
  return 1
}

# ============================================
# Config
# ============================================

derive_config() {
  log_step "Loading configuration..."

  # Load from .env
  if [ -f .env ]; then
    # shellcheck source=/dev/null
    source .env
  fi

  if [ -z "$REGISTRY" ]; then
    log_error "REGISTRY environment variable not set"
    exit 1
  fi

  if [ -z "$INFRA_DIR" ]; then
    log_error "INFRA_DIR environment variable not set"
    exit 1
  fi

  if [ ! -x "$INFRA_DIR/bin/tf" ]; then
    log_error "Infrastructure not found at $INFRA_DIR/bin/tf"
    exit 1
  fi

  # Derive from git
  GITHUB_REPO=$(git remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/](.*)\.git$#\1#')
  SHA=$(git rev-parse HEAD)
  BRANCH=$(git rev-parse --abbrev-ref HEAD)

  DIGEST_DIR=$(mktemp -d)

  log_info "Repository: $GITHUB_REPO"
  log_info "Branch: $BRANCH"
  log_info "Commit: ${SHA:0:7}"
  log_info "Registry: $REGISTRY"
}

# ============================================
# Pre-flight checks
# ============================================

check_docker() {
  log_step "Checking Docker..."

  if docker info &>/dev/null; then
    log_success "Docker is running"
    return 0
  fi

  [[ ! -d /Applications/OrbStack.app ]] && log_error "Docker is not running and OrbStack not found" && return 1

  log_info "Docker not running, starting OrbStack..."
  open -a OrbStack

  wait_for_condition "OrbStack started" $DOCKER_CHECK_TIMEOUT docker info && return 0

  log_error "Docker failed to start within ${DOCKER_CHECK_TIMEOUT}s"
  return 1
}

# Grades the pages circulation actually renders (a11y invariants + Lighthouse),
# not the design mockups the two gates pointed at before. Catches the class of
# regression that ships silently because nothing is broken enough to 500.
check_web() {
  if [[ $SKIP_WEB_CHECK == true ]]; then
    log_info "Skipping web gate (--skip-web-check)"
    return 0
  fi

  log_step "Checking rendered pages (a11y + Lighthouse)..."

  if dry_run_skip "bin/web-check"; then
    return 0
  fi

  if "$SCRIPT_DIR/web-check"; then
    log_success "Web gate passed"
    return 0
  fi

  log_error "Web gate failed -- fix, or re-run with --skip-web-check"
  return 1
}

check_tailscale() {
  log_step "Checking Tailscale..."

  rm -f "$TAILSCALE_MARKER"

  command -v tailscale &>/dev/null || { log_error "Tailscale not installed"; return 1; }

  if tailscale status &>/dev/null; then
    log_success "Tailscale already connected"
    return 0
  fi

  dry_run_skip "open -a Tailscale" && return 0

  log_info "Starting Tailscale..."
  touch "$TAILSCALE_MARKER"
  open -a Tailscale

  wait_for_condition "Tailscale connected" $TAILSCALE_TIMEOUT tailscale status && return 0

  log_error "Tailscale failed to connect within ${TAILSCALE_TIMEOUT}s"
  rm -f "$TAILSCALE_MARKER"
  return 1
}

# ============================================
# GitHub Deployments API
# ============================================

DEPLOYMENT_ID=""

create_deployment() {
  log_step "Creating GitHub deployment..."

  if ! command -v gh &>/dev/null; then
    log_info "GitHub CLI not installed, skipping deployment tracking"
    return 0
  fi

  if dry_run_skip "gh api repos/${GITHUB_REPO}/deployments"; then
    return 0
  fi

  DEPLOYMENT_ID=$(echo '{"ref":"'"$SHA"'","environment":"production","auto_merge":false,"required_contexts":[]}' \
    | gh api "repos/${GITHUB_REPO}/deployments" --input - --jq '.id' 2>/dev/null || echo "")

  if [ -n "$DEPLOYMENT_ID" ]; then
    gh api "repos/${GITHUB_REPO}/deployments/${DEPLOYMENT_ID}/statuses" \
      -f state="in_progress" \
      -f log_url="https://github.com/${GITHUB_REPO}/actions" \
      -f description="Deploying..." \
      --silent 2>/dev/null || true
    log_success "Deployment #$DEPLOYMENT_ID created"
  fi
}

update_deployment_status() {
  local state="$1" description="$2"

  [[ -z $DEPLOYMENT_ID ]] && return 0
  command -v gh &>/dev/null || return 0
  dry_run_skip "gh api deployment status: $state" && return 0

  gh api "repos/${GITHUB_REPO}/deployments/${DEPLOYMENT_ID}/statuses" \
    -f state="$state" \
    -f log_url="https://github.com/${GITHUB_REPO}/actions" \
    -f description="$description" \
    --silent 2>/dev/null || true
}

# ============================================
# Git operations
# ============================================

push_to_github() {
  log_step "Checking git status..."

  # Check if remote branch exists
  if ! git rev-parse --verify origin/"$BRANCH" &>/dev/null; then
    log_info "Remote branch origin/$BRANCH does not exist"
    dry_run_skip "git push -u origin $BRANCH" && return 0
    git push -u origin "$BRANCH"
    log_success "Pushed new branch to GitHub"
    return 0
  fi

  local ahead
  ahead=$(git rev-list --count origin/"$BRANCH".."$BRANCH" 2>/dev/null || echo "0")

  if [[ $ahead == 0 ]]; then
    log_info "Already up to date with origin/$BRANCH"
    return 0
  fi

  log_info "$ahead commit(s) to push"
  dry_run_skip "git push origin $BRANCH" && return 0

  run_quiet git push origin "$BRANCH"
  log_success "Pushed to GitHub"
}

# --rollback: the tag's own record (tag_deployment writes it) becomes this run's pins, and its
# commit this run's SHA, so terraform, the GitHub deployment and the new tag all name what runs.
load_rollback() {
  local msg name value sha="" missing="" svc
  local -a pins=()
  msg=$(git tag -l --format='%(contents)' "$ROLLBACK_TAG" 2>/dev/null) || msg=""
  if [ -z "$msg" ]; then
    log_error "no annotated tag $ROLLBACK_TAG in this checkout -- git fetch --tags, then pick one: git tag -n3 -l 'deploy/*'"
    return 1
  fi
  while read -r name value; do
    if [[ $name == deploy && $value =~ ^[0-9a-f]{40}$ ]]; then
      sha=$value
    elif [[ $name =~ ^[a-z0-9-]+$ && $value =~ ^sha256:[0-9a-f]{64}$ ]]; then
      pins+=("$name $value")
    fi
  done <<<"$msg"
  if [ -z "$sha" ] || [ ${#pins[@]} -eq 0 ]; then
    log_error "$ROLLBACK_TAG records no commit or no image digests -- nothing to roll back to by digest"
    return 1
  fi
  local pin
  for pin in "${pins[@]}"; do
    echo "${pin#* }" > "$DIGEST_DIR/${pin%% *}.digest"
  done
  for svc in "$SERVICE_CIRCULATION" "$SERVICE_NEWSROOM" "$SERVICE_WORKER" "$SERVICE_PYTHON" "$SERVICE_SITE"; do
    [ -e "$DIGEST_DIR/$svc.digest" ] || missing+=" $svc"
  done
  SHA=$sha
  SKIP_BUILD=true
  log_info "Rolling back to $ROLLBACK_TAG: commit ${SHA:0:7}, ${#pins[@]} image(s) by digest"
  [ -z "$missing" ] || log_error "$ROLLBACK_TAG pins no digest for${missing}, so terraform runs :latest for those"
}

tag_deployment() {
  local tag="deploy/$(date -u +%Y-%m-%d-%H%M%SZ)"

  log_step "Tagging deployment as $tag..."
  dry_run_skip "git tag $tag && git push origin $tag" && return 0

  # The only durable record of the digests -- DIGEST_DIR is a mktemp and terraform state keeps
  # only a script hash. Drop it and a rollback target can only be named by re-resolving a tag.
  local msg="deploy $SHA"
  [ -z "$ROLLBACK_TAG" ] || msg="$msg
(rollback to $ROLLBACK_TAG)"
  local -a digests=("$DIGEST_DIR"/*.digest)
  local file
  if [ -e "${digests[0]}" ]; then
    for file in "${digests[@]}"; do
      msg="$msg
$(basename "$file" .digest) $(cat "$file")"
    done
  else
    msg="$msg
(no images built this run -- deployed whatever :latest pointed at)"
  fi

  git tag -a "$tag" -m "$msg" "$SHA"
  git push origin "$tag" --quiet
  log_success "Tagged: $tag"
}

# ============================================
# Build and deploy
# ============================================

build_and_push_image() {
  local name="$1" context="$2" dockerfile="$3" extra_args="$4" scan="$5"
  local tag="$REGISTRY/$name:latest"
  # Keeps a deployed image addressable once `:latest` moves and GC can prune untagged manifests.
  # Last build of each commit only: rebuilds are not reproducible and re-point the tag.
  local sha_tag="$REGISTRY/$name:${SHA:0:7}"

  log_step "Building $name..."
  if [ -n "$dockerfile" ]; then
    # shellcheck disable=SC2086
    run_or_skip "docker buildx build $name" \
      run_quiet docker buildx build --platform linux/amd64 $extra_args \
        --build-arg OCI_REVISION="$SHA" -t "$tag" -t "$sha_tag" -f "$dockerfile" "$context"
  else
    run_or_skip "docker buildx build $name" \
      run_quiet docker buildx build --platform linux/amd64 \
        --build-arg OCI_REVISION="$SHA" -t "$tag" -t "$sha_tag" "$context"
  fi

  # SBOM + audit BEFORE the push, deliberately. `docker push "$tag"` advances the MUTABLE
  # :latest tag, and terraform falls back to :latest whenever no digest is pinned -- which is
  # exactly what `bin/deploy --skip-build` does. Auditing after the push would mean a BLOCKED
  # deploy had already parked the vulnerable image where the documented recovery command ships
  # it. Ordered this way, a failed audit leaves the registry untouched.
  generate_sbom "$name" "$dockerfile" "$scan" || return 1

  log_step "Pushing $name..."
  if ! dry_run_skip "docker push $name"; then
    local push_log="$DIGEST_DIR/$name.push.log"
    if ! docker push "$tag" >"$push_log" 2>&1; then
      log_error "push failed for $name"
      tail -20 "$push_log" >&2
      return 1
    fi
    run_quiet docker push "$sha_tag"
    capture_digest "$name" "$push_log"
  fi
}

# Written to a file, not a variable: builds run in parallel subshells.
capture_digest() {
  local name="$1" push_log="$2"

  # From THIS push's own output, not by re-resolving `:latest` afterwards -- asking the registry
  # what the tag points at now reintroduces the moving-pointer race the pinning exists to remove.
  local digest
  digest=$(grep -oE 'digest: sha256:[0-9a-f]{64}' "$push_log" | head -1 | sed 's/^digest: //')

  if [ -z "$digest" ]; then
    log_error "could not read pushed digest for $name from push output -- refusing to continue unpinned"
    return 1
  fi

  # The .digest suffix keeps $name.push.log out of the glob that other steps iterate.
  echo "$digest" > "$DIGEST_DIR/$name.digest"
  log_success "$name pinned at ${digest:0:19}..."
}

# CycloneDX SBOM feeding `still_active --sbom=`. Swapping a service's scan target yields a
# confident SBOM of software that was never shipped:
#   circulation -> source; the image holds only apk once the cargo graph is a static binary.
#   newsroom -> image; a source scan reads uv.lock, which the Dockerfile never installs from.
#   site -> bundled; the image has no node_modules, so a scan finds no npm packages. The build
#     writes the SBOM from the lockfile and the bundle's metafile, and it is copied out of the image.
generate_sbom() {
  local name="$1" dockerfile="$2" scan="$3"
  if [ "$scan" = "bundled" ]; then
    dry_run_skip "copy $SITE_SBOM_PATH out of $name and audit it" && return 0
    bundled_sbom "$name"
    return
  fi
  dry_run_skip "syft SBOM for $name" && return 0

  # Blocks, like a missing still_active. Returning 0 here would mean `generate_sbom || return 1`
  # gates a failed AUDIT but ships an image nobody could audit at all -- the asymmetry is
  # invisible at the call site and the quieter half is the dangerous one.
  if ! command -v syft &>/dev/null; then
    [[ $SKIP_SBOM_AUDIT == true ]] && { log_error "syft not installed -- NO SBOM for $name (proceeding, --skip-sbom-audit)"; return 0; }
    log_error "syft not installed -- cannot produce an auditable SBOM for $name; install it or pass --skip-sbom-audit"
    return 1
  fi

  mkdir -p "$SBOM_DIR" # past dry_run_skip above, so --dry-run leaves no directory in the repo
  local out="$SBOM_DIR/$name-${SHA:0:7}.cdx.json" target
  local -a syft_args=(--source-name "$name")

  # No default: a new service must choose at its call site rather than inherit the wrong scan.
  if [ "$scan" != "image" ] && [ "$scan" != "source" ]; then
    log_error "$name: scan target must be 'image', 'source' or 'bundled', got '${scan:-empty}' -- NO SBOM generated"
    return 0
  fi

  if [ "$scan" = "image" ]; then
    # The LOCAL image for this commit, scanned before it is pushed. Naming the pushed digest
    # would be more precise about what sits in the registry, but it can only be known after the
    # push, which is too late to stop it. The push does not transform the image, so these are the
    # same bytes; --source-version records which commit built them.
    target="$REGISTRY/$name:${SHA:0:7}"
    syft_args+=(--source-version "$SHA")
  else
    # --exclude is insurance against a future build layout; no effect on the count today.
    target="dir:$(dirname "$dockerfile")"
    syft_args+=(--source-version "$SHA" --exclude './target/**')
  fi

  if ! run_quiet syft "$target" "${syft_args[@]}" -o cyclonedx-json="$out"; then
    log_error "SBOM generation failed for $name -- nothing to audit"
    return 1
  fi

  # Negative control: syft exiting 0 is not evidence of a usable file. A truncated or empty write
  # would otherwise log green and hand still_active a file it chokes on.
  # Count PACKAGES (purl-bearing), not components: syft also catalogues individual files, which
  # for the newsroom image is 2208 of 2371 entries. An SBOM of nothing but file entries would pass
  # a bare `.components | length > 0` while carrying no dependency graph to audit.
  check_sbom_and_audit "$name" "$out"
}

check_sbom_and_audit() {
  local name="$1" out="$2"
  if [ ! -s "$out" ] || ! jq -e '[.components[] | select(.purl)] | length > 0' "$out" >/dev/null 2>&1; then
    log_error "SBOM for $name is empty or unparseable at $out -- nothing to audit"
    return 1
  fi

  log_success "SBOM: $out ($(jq '[.components[] | select(.purl)] | length' "$out") packages)"
  audit_sbom "$name" "$out"
}

# From the LOCAL image for this commit, as the image scan reads it: the SBOM the pushed bytes carry,
# not one rebuilt beside them.
SITE_SBOM_PATH="/app/digest/site.cdx.json"
bundled_sbom() {
  local name="$1" cid rc=0
  mkdir -p "$SBOM_DIR"
  local out="$SBOM_DIR/$name-${SHA:0:7}.cdx.json"
  if ! cid=$(docker create "$REGISTRY/$name:${SHA:0:7}" 2>/dev/null) || [ -z "$cid" ]; then
    log_error "could not create a container from $name to copy $SITE_SBOM_PATH out -- nothing to audit"
    return 1
  fi
  docker cp "$cid:$SITE_SBOM_PATH" "$out" >/dev/null 2>&1 || rc=$?
  docker rm "$cid" >/dev/null 2>&1 || true
  if [[ $rc != 0 ]]; then
    log_error "$name carries no $SITE_SBOM_PATH (docker cp exit $rc) -- nothing to audit"
    return 1
  fi
  check_sbom_and_audit "$name" "$out"
}

# The SBOM gate. Generating an SBOM and printing the command that would audit it is not a gate --
# on 2026-08-22 the shipped newsroom image (built 2026-08-11) was found carrying three HIGH
# sqlparse CVEs that nothing had ever looked at.
#
# --fail-if-vulnerable, NOT --fail-if-critical. "critical" in still_active is about MAINTENANCE
# activity, not vulnerabilities: against that same image it exited 0 with those three HIGHs in the
# graph, while exiting 1 on circulation, which has no CVEs at all. Nearly orthogonal flags, and
# gating on the wrong one reads as coverage while catching nothing.
#
# `high`, not `medium`: the newsroom image carries pip with a MEDIUM (CVSS 6.5) that comes from
# the python:3.14-slim base rather than constraints-prod.txt, so `medium` would block every deploy
# until upstream ships a newer pip. --fail-if-deprecated rides along because it is free -- same
# deps.dev response, no extra request -- but it is NOT coverage: deps.dev only populates
# isDeprecated for npm/go/nuget, and both images are entirely pypi and cargo, so it is measured to
# catch nothing here today. It is on to cover a future ecosystem, not because it guards this one.
#
# THE HARD PART is that still_active reports every caveat on STDERR and none of it in the exit
# code or the JSON. Read the exit code alone and the quietest possible failure -- the advisory
# lookup silently returning nothing -- is indistinguishable from a clean bill of health.
audit_sbom() {
  local name="$1" out="$2" rc=0
  local json="$out.audit.json" log="$out.audit.log"

  if [[ $SKIP_SBOM_AUDIT == true ]]; then
    log_error "SBOM audit SKIPPED for $name (--skip-sbom-audit) -- this image is shipping unaudited"
    return 0
  fi
  if ! command -v still_active &>/dev/null; then
    log_error "still_active not installed -- cannot audit $name; install it or pass --skip-sbom-audit"
    return 1
  fi

  # A URL install keeps a registry purl, so still_active audits a different package under its name
  # (the googlenewsdecoder fork reads as PyPI's googlenewsdecoder). Unlisted ones block; listed
  # exceptions are printed as unaudited. syft gives Cargo and npm git dependencies no vcs reference,
  # so the lockfiles go in too.
  if ! python3 "$SCRIPT_DIR/sbom-unregistered" "$out" "$SCRIPT_DIR/../circulation/Cargo.lock" "$SCRIPT_DIR/../digest/package-lock.json"; then
    log_error "SBOM audit for $name: a dependency ships from a URL no audit covers (above)"
    return 1
  fi

  # One invocation: --json and --fail-if-vulnerable coexist, stdout carries the report and the
  # exit code is still the verdict. Two runs would double the load on free advisory APIs, which is
  # the very thing that pushes them into the degraded mode handled below. ~25s per SBOM.
  set +e
  still_active --sbom="$out" --json --fail-if-vulnerable=high --fail-if-deprecated >"$json" 2>"$log"
  rc=$?
  set -e

  # rc 2+ is still_active failing to RUN (bad flag after an upgrade, unparseable SBOM), not a
  # verdict about the image. Reporting that as "ships a vulnerability" would be a confident false
  # claim, and the remedy printed on that branch -- turn the gate off -- is the wrong reflex.
  if [[ $rc -ne 0 && $rc -ne 1 ]]; then
    log_error "SBOM audit for $name could NOT RUN (still_active exit $rc) -- image is unaudited; see $log"
    return 1
  fi

  # THE fail-open, and the reason this is not just `still_active || return 1`.
  #
  # The SBOM path has exactly one vulnerability source: deps.dev's `advisoryKeys`. still_active
  # degrades a missing or unreachable one to an empty list, so the package comes back with dates,
  # licence and scorecard intact, `status: "ok"`, vulnerability_count 0, and the run exits 0.
  # Measured 2026-08-24 on an SBOM pinning sqlparse 0.5.5 (three HIGH CVEs): renaming that ONE
  # field flipped rc 1 -> 0 and "vulnerable" -> "ok". Nothing in the JSON moves.
  #
  # `status_counts.unknown` is NOT the signal and was a wrong first guess: it is set from
  # version_unresolved, i.e. whether deps.dev indexes the pinned VERSION, not whether advisories
  # were retrieved. It stays 0 through advisory drift, and it goes positive on perfectly healthy
  # input -- a git-pinned wheel like googlenewsdecoder 404s there -- which would block the deploy
  # forever while blaming the network. It is reported below as coverage, never as a verdict.
  #
  # still_active does detect this, via a live canary on a known-vulnerable pin, and says so on
  # stderr. That line is the only thing that moves, so it is what the gate reads.
  if grep -qi "NOT authoritative" "$log"; then
    log_error "SBOM audit for $name is NOT AUTHORITATIVE -- still_active could not confirm advisories (API drift, outage or rate limit); see $log"
    return 1
  fi

  local assessed unassessable unknown dropped total
  assessed=$(jq -r '.summary.total_assessed // empty' "$json" 2>/dev/null)
  unassessable=$(jq -r '.summary.unassessable_count // 0' "$json" 2>/dev/null || echo 0)
  unknown=$(jq -r '.summary.status_counts.unknown // 0' "$json" 2>/dev/null || echo 0)

  # Negative control on the instrument, mirroring the one generate_sbom runs on syft. `jq` over an
  # EMPTY file exits 0 and prints NOTHING, so a `|| echo 0` fallback never fires -- a truncated
  # write or a renamed `.summary` would otherwise sail through as "0 assessed, clean".
  if [[ -z "$assessed" || "$assessed" == "0" ]]; then
    log_error "SBOM audit for $name produced no assessment ($json empty or unrecognised) -- image is unaudited"
    return 1
  fi

  if [[ $rc -eq 1 ]]; then
    log_error "SBOM audit: $name ships a HIGH+ vulnerability or a deprecated dependency -- see $log"
    local findings
    # Only what actually blocks. An unfiltered list prints the MEDIUM pip finding beside the HIGHs
    # and sends someone chasing an upgrade that lives in the base image and cannot be made. The
    # cvss>=7.0 clause is load-bearing: half of sqlparse's records are PYSEC twins carrying a real
    # score with a null label.
    findings=$(jq -r '.dependencies[]
           | . as $d
           | (.vulnerabilities // [])
           | map(select((.osv_severity // "") == "HIGH" or (.osv_severity // "") == "CRITICAL"
                        or (.osv_cvss_score // 0) >= 7.0))
           | select(length > 0)
           | "  \($d.name) \($d.version_used) -> \($d.latest_version): "
             + (map(.aliases[0] // .id) | unique | join(", "))' "$json" 2>/dev/null || true)
    findings+=$(jq -r '.dependencies[] | select(.deprecated) | "  \(.name) is DEPRECATED: \(.deprecation_reason // "no reason given")"' "$json" 2>/dev/null || true)
    if [[ -n "${findings//[[:space:]]/}" ]]; then
      printf '%s\n' "$findings"
    else
      # still_active fails CLOSED on an advisory carrying neither a severity label nor a score --
      # "a freshly disclosed CVE often has neither yet" -- and such an advisory matches no filter
      # above. Printing two red lines and no reason is what sends an operator straight to the
      # bypass flag, so say where the reason actually is.
      log_error "  (no HIGH+ advisory could be named: still_active fails closed on an unscored advisory. The reason is in $log)"
    fi
    log_error "Fix it, or re-run with --skip-sbom-audit if the vector is unreachable and you have written down why."
    return 1
  fi

  # Says what it actually covered, because "156 packages" beside "clean" reads as 156 clean. An
  # image scan never assesses the Debian half, still_active drops the SBOM graph's ROOT components
  # (for newsroom that silently omits seven DIRECT Python deps -- claude-agent-sdk, resend,
  # trafilatura, yoyo-migrations among them), and an unresolved version was not really checked.
  # This gate catches a CVE in a leaf, not in a top-level pin.
  total=$(jq '[.components[] | select(.purl)] | length' "$out" 2>/dev/null || echo 0)
  dropped=$(( total - assessed - unassessable ))
  [[ $dropped -lt 0 ]] && dropped=0
  log_success "SBOM audit: $name clean at high+ ($assessed of $total assessed; $unassessable not assessable, $dropped dropped, $unknown version-unresolved)"
}

build_and_push() {
  if [ "$SKIP_BUILD" = "true" ]; then
    log_info "Skipping build (--skip-build)"
    return 0
  fi

  # Audit Rust deps before shipping
  log_step "Auditing Rust dependencies..."
  run_or_skip "cargo audit" \
    run_quiet docker compose run --rm ci-rust "cargo audit"

  log_step "Building images (parallel)..."

  build_and_push_image "$SERVICE_CIRCULATION" "." "circulation/Dockerfile" "" source &
  local circ_pid=$!

  build_and_push_image "$SERVICE_NEWSROOM" "." "newsroom/Dockerfile" "--build-arg GIT_SHA=${SHA:0:7}" image &
  local news_pid=$!

  # The Temporal workers only when the box runs them: in "python" mode they are not built, gated
  # or pushed, so a problem in digest/ cannot block a Python deploy. Image scans, like newsroom:
  # the worker's graph is the pruned node_modules the image ships, and the Python worker's is the venv
  # its image builds from digest/python/uv.lock without the dev group. The site is the same
  # Dockerfile's `site` target; its SBOM is the bundle's own (generate_sbom).
  local worker_pid="" python_pid="" site_pid=""
  if temporal_on; then
    build_and_push_image "$SERVICE_WORKER" "." "digest/Dockerfile" "--target worker --build-arg GIT_SHA=${SHA:0:7}" image &
    worker_pid=$!
    build_and_push_image "$SERVICE_PYTHON" "." "digest/python/Dockerfile" "" image &
    python_pid=$!
    build_and_push_image "$SERVICE_SITE" "." "digest/Dockerfile" "--target site --build-arg GIT_SHA=${SHA:0:7}" bundled &
    site_pid=$!
  fi

  local circ_failed=false news_failed=false worker_failed=false python_failed=false site_failed=false
  wait "$circ_pid" || circ_failed=true
  wait "$news_pid" || news_failed=true
  if [ -n "$worker_pid" ]; then wait "$worker_pid" || worker_failed=true; fi
  if [ -n "$python_pid" ]; then wait "$python_pid" || python_failed=true; fi
  if [ -n "$site_pid" ]; then wait "$site_pid" || site_failed=true; fi

  if [ "$circ_failed" = "true" ] || [ "$news_failed" = "true" ] || [ "$worker_failed" = "true" ] || [ "$python_failed" = "true" ] || [ "$site_failed" = "true" ]; then
    # "or its SBOM audit": generate_sbom runs BEFORE the push, so an image that built cleanly
    # still lands here when it ships a HIGH+ vulnerability -- and it was never pushed. Saying only
    # "build failed" would send the next reader to the Dockerfile for a dependency problem.
    [ "$circ_failed" = "true" ] && log_error "$SERVICE_CIRCULATION build or its SBOM audit failed"
    [ "$news_failed" = "true" ] && log_error "$SERVICE_NEWSROOM build or its SBOM audit failed"
    [ "$worker_failed" = "true" ] && log_error "$SERVICE_WORKER build or its SBOM audit failed"
    [ "$python_failed" = "true" ] && log_error "$SERVICE_PYTHON build or its SBOM audit failed"
    [ "$site_failed" = "true" ] && log_error "$SERVICE_SITE build or its SBOM audit failed"
    return 1
  fi

  log_success "Images built and pushed"
}

# Must stay ahead of run_migrations: it is the only check covering newsroom, and after that point
# digest.db is already mutated. Catches a Dockerfile that stops threading the ARG into the LABEL.
# Reads the LOCAL store, so moving to `buildx --push` would make every service report "missing".
verify_provenance() {
  if [ -n "$ROLLBACK_TAG" ]; then
    log_info "--rollback: nothing built here; these images passed this check when $ROLLBACK_TAG shipped"
    return 0
  fi
  dry_run_skip "verify image provenance" && return 0

  local -a digests=("$DIGEST_DIR"/*.digest)
  if [ ! -e "${digests[0]}" ]; then
    log_error "nothing pinned this run -- every service deploys the mutable :latest tag"
    return 0
  fi

  local file name got failed=false
  for file in "${digests[@]}"; do
    name=$(basename "$file" .digest)
    got=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
      "$REGISTRY/$name:${SHA:0:7}" 2>/dev/null || echo "")
    if [ "$got" = "$SHA" ]; then
      log_success "$name provenance verified (${SHA:0:7})"
    else
      log_error "$name revision label is '${got:-missing}', expected $SHA"
      failed=true
    fi
  done

  [ "$failed" = false ] || { log_error "refusing to deploy before anything irreversible runs"; return 1; }
}

# Snapshot digest.db (and the other volumes) to the Mac BEFORE migrations
# mutate it in place -- yoyo has no down-migrations here, so this snapshot is
# the rollback path. Lives in the infra repo because it is server-level, not
# digest-level (it also covers kamal-proxy certs and Claude session data).
# Loud-but-non-fatal: a failed snapshot must not block a deploy, and the
# script raises its own macOS notification; the age of the newest verified
# backup is printed so staleness is visible right here in the deploy output.
# --fresh-digest-dump: by default the script copies the box's newest nightly
# pg_dump, up to a day old; this runs the box's dump first, so the copy is from
# just before the migration. The script skips it in python mode on its own.
backup_data() {
  log_step "Snapshotting server volumes to this Mac (pre-migration)..."
  dry_run_skip "$INFRA_DIR/bin/backup-volumes --fresh-digest-dump" && return 0

  # A missing script is a different emergency than a failed run: it means no
  # backups are happening anywhere (the daily launchd job uses the same path).
  if [ ! -x "$INFRA_DIR/bin/backup-volumes" ]; then
    log_error "backup script missing at $INFRA_DIR/bin/backup-volumes -- volume backups are NOT running at all"
    return 0
  fi

  local rc=0
  "$INFRA_DIR/bin/backup-volumes" --fresh-digest-dump || rc=$?
  # 64 is its usage error: an infra checkout older than the flag, which copies no Postgres dump at all.
  if [[ $rc == 64 ]]; then
    log_error "$INFRA_DIR/bin/backup-volumes predates --fresh-digest-dump -- snapshotting without it, so NO Postgres dump; update the infra checkout"
    rc=0
    "$INFRA_DIR/bin/backup-volumes" || rc=$?
  fi
  if [[ $rc == 0 ]]; then
    log_success "Volumes backed up and restore-verified"
  else
    log_error "Volume backup FAILED -- deploying WITHOUT a fresh pre-migration snapshot"
    "$INFRA_DIR/bin/backup-volumes" --status || true
  fi
}

run_migrations() {
  # Migrations are forward-only and an older image carries none the database lacks; migrating would
  # also pull the image from the registry.
  if [ -n "$ROLLBACK_TAG" ]; then
    log_info "--rollback: skipping migrations (forward-only; the schema stays as it is)"
    return 0
  fi
  log_step "Running database migrations..."

  # Same pinned image terraform will run. Migrating with `:latest` would leave a window where the
  # schema is written by a different build than the one that then boots against it -- the pinning
  # is worthless if the step that mutates the database opts out of it.
  local newsroom_digest image_ref
  newsroom_digest=$(cat "$DIGEST_DIR/$SERVICE_NEWSROOM.digest" 2>/dev/null || echo "")
  image_ref="${newsroom_digest:+$REGISTRY/$SERVICE_NEWSROOM@$newsroom_digest}"
  if [ -z "$image_ref" ]; then
    image_ref="$REGISTRY/$SERVICE_NEWSROOM:latest"
    log_error "migrating with the UNPINNED :latest tag -- this step mutates digest.db"
  fi

  local docker_cmd="docker run --rm -v news-digest-data:/app/data -e IN_DOCKER=1 $image_ref ./bin/migrate"

  if dry_run_skip "$docker_cmd"; then
    return 0
  fi

  # Pull latest image first
  run_quiet "$SCRIPT_DIR/ssh" "docker pull $image_ref"

  # Check for pending migrations
  local status
  if ! status=$("$SCRIPT_DIR/ssh" "$docker_cmd --dry-run" 2>&1); then
    log_error "Failed to check migration status"
    return 1
  fi

  if echo "$status" | grep -q "None"; then
    log_info "No pending migrations"
    return 0
  fi

  log_info "Pending migrations found"

  if ! "$SCRIPT_DIR/ssh" "$docker_cmd"; then
    log_error "Migration failed!"
    return 1
  fi

  log_success "Migrations applied"
}

# Which pipeline the box runs: terraform's var.news_digest_pipeline, read from the infra repo the
# way mcp_smoke reads the domain. "python" means no Temporal stack on the box, and then this script
# never builds, targets, pauses or restores anything of it.
PIPELINE_MODE=""

read_pipeline_mode() {
  log_step "Reading the live pipeline mode..."
  local raw
  raw=$(echo 'var.news_digest_pipeline' | "$INFRA_DIR/bin/tf" console 2>/dev/null | tr -d '"[:space:]') || raw=""
  case $raw in
    python|staged|temporal) PIPELINE_MODE=$raw ;;
    # Not a guess and not a default: a mode read wrong would skip the pause, or build and target a
    # stack that is not there. Same lesson as mcp_smoke's domain (a warning captured as a value).
    *) log_error "var.news_digest_pipeline did not resolve to python|staged|temporal (got: '$(printf '%.60s' "${raw:-<empty>}")')"; return 1 ;;
  esac
  log_info "Pipeline mode: $PIPELINE_MODE"
}

temporal_on() { [[ $PIPELINE_MODE == staged || $PIPELINE_MODE == temporal ]]; }

# tfvars can say "python" while the box still runs Temporal: set straight from "temporal", skipping
# the teardown. A deploy would then re-enable the Persistent timer beside a live schedule, and both
# pipelines would send. So in "python" the box is asked, and a stack still there stops the deploy.
check_box_matches_mode() {
  [[ $PIPELINE_MODE == python ]] || return 0
  log_step "Checking the box has no Temporal stack (mode python)..."
  local probe="if test -e $SCHEDULE_CTL -o -e /etc/systemd/system/news-digest-temporal.service; then echo PRESENT; else echo ABSENT; fi"
  dry_run_skip "bin/ssh '$probe'" && return 0

  # The answer is a token the box prints, never an exit code: bin/ssh exits 1 on its own, before
  # ssh runs, when it cannot resolve the host (INFRA_DIR unset, tf output failing), and an exit-code
  # probe read that as "absent".
  local out
  out=$("$SCRIPT_DIR/ssh" "$probe") || true # stdout only; ssh's own stderr still reaches the terminal
  case $out in
    PRESENT) log_error "mode is python but the box still runs the Temporal stack -- tear it down first (docs/2026-09-23-temporal-cutover-runbook.md, \"Teardown\"), or set the mode back"; return 1 ;;
    ABSENT) log_success "no Temporal stack on the box" ;;
    *) log_error "could not check the box for a Temporal stack -- refusing rather than guessing: $(printf '%.200s' "${out:-<no output>}")"; return 1 ;;
  esac
}

# The worker refuses to start without DIGEST_DATABASE_URL (digest/src/worker.ts), which terraform
# writes into its env. Infra that predates the product database writes none, and the apply would
# succeed with a worker that never starts. (An empty password terraform's own preconditions refuse,
# at plan; this says so before the builds.) Asked of terraform's rendering of that env, as a regex
# over it, so the URL, which carries the password, is never printed. The answer is stdout's last
# line: bin/tf warns on stderr (an unreadable optional secret) and still exits 0.
check_database_url() {
  temporal_on || return 0
  log_step "Checking terraform gives the worker DIGEST_DATABASE_URL..."
  local expr out err rc=0
  expr='can(regex("(?m)^DIGEST_DATABASE_URL=postgres://[^:/@]+:[^@]+@", local.news_digest_worker_env_content))'
  err=$(mktemp)
  out=$(echo "$expr" | "$INFRA_DIR/bin/tf" console 2>"$err") || rc=$?
  if [[ $rc == 0 && $(tail -n 1 <<<"$out" | tr -d '[:space:]') == true ]]; then
    rm -f "$err"
    log_success "the worker's env carries DIGEST_DATABASE_URL"
    return 0
  fi
  # Terraform's errors come boxed in colour codes; the first plain "Error:" line says what it was.
  local why
  why=$(sed $'s/\x1b\\[[0-9;]*m//g' "$err" | grep -m1 -o 'Error: .*' || true)
  rm -f "$err"
  log_error "terraform does not give the worker a DIGEST_DATABASE_URL with a password (tf console exit $rc, answer '$(printf '%.40s' "$(tail -n 1 <<<"$out")")'${why:+, $why}) -- the worker would refuse to start. Apply infra that has the product database (seanfloyd.dev news-digest-temporal.tf, local.news_digest_worker_env_content) and check NEWS_DIGEST_DB_PASSWORD in op://Private/seanfloyd.dev"
  return 1
}

# A paused schedule drops the slot it misses, and a deploy restarts the worker under a run, so with
# Temporal live a deploy is refused from 12:00 (before the 12:25 start) to 13:45 Europe/Paris (past a normal
# run's end). digest-schedule sync still starts a missed day once if a --force deploy spans the start.
check_run_window() {
  [[ $PIPELINE_MODE == temporal ]] || return 0
  # The schedule fires at 12:25 Europe/Paris (digest/src/client.ts): 10:25Z in summer, 11:25Z in winter.
  local now
  now=$(TZ=Europe/Paris date +%H%M)
  if (( 10#$now >= 1200 && 10#$now < 1345 )); then
    if [[ $FORCE == true ]]; then
      log_error "deploying inside the Temporal run window (${now} Europe/Paris) under --force"
      return 0
    fi
    log_error "${now} Europe/Paris is inside the Temporal run window (12:00-13:45 Europe/Paris) -- deploy after it, or pass --force"
    return 1
  fi
}

# Deploys never overlap the run window (spec §2.1): in "staged" and "temporal" the daily schedule is
# paused before anything is migrated or restarted, and its state is re-derived after the apply.
# In "python" there is no schedule and neither function runs.
SCHEDULE_PAUSED=false

# A run is pinned to the worker build that started it (digest/src/deployment.ts), and this box runs
# one worker: a deploy stops the only worker of that build, and the run sits, with no alert, until
# moved or its run timeout (set_current_version names it). So in temporal a deploy refuses while a
# DigestWorkflow runs. In staged the runs are rehearsals on a scratch database and Python is live, so
# it warns and deploys: a Temporal problem must not block Python's deploy.
# It asks twice: before the builds, to fail fast, and after the pause, so the schedule cannot start a
# run between the answer and the restart. One path still can: the apply restarts the bootstrap
# (digest-schedule sync) before the workers, and on a day with no run yet after the start its missed-day
# trigger starts one on the old worker. Terraform cannot order it after them (the workers depend on
# it: it creates the namespace). point_current_at_new_build makes such a run wait for the new build;
# set_current_version names any run still stranded.
# An answer that is not a complete JSON list (Temporal unreachable, ssh failing, output cut short)
# counts as a problem too: the CLI can print "[]" and then fail, so the exit code is read as well.
# --force deploys anyway, loudly. The names are terraform's (news-digest-temporal.tf), the runbook's $T.
TEMPORAL_CLI="docker run --rm --network news-digest-temporal -e TEMPORAL_ADDRESS=news-digest-temporal:7233 -e TEMPORAL_NAMESPACE=news-digest temporalio/admin-tools:1.32.0 temporal"
RUNNING_DIGESTS_QUERY='WorkflowType="DigestWorkflow" AND ExecutionStatus="Running"'

# Refuses in temporal; in staged, or under --force, logs the problem and lets the deploy go on.
temporal_problem() {
  local problem=$1 remedy=$2
  if [[ $FORCE == true ]]; then
    log_error "$problem -- deploying under --force"
    return 0
  fi
  if [[ $PIPELINE_MODE == staged ]]; then
    log_error "$problem -- deploying anyway: in staged the TypeScript runs are rehearsals and Python is live"
    return 0
  fi
  log_error "$problem -- $remedy, or pass --force"
  return 1
}

check_no_run_in_flight() {
  temporal_on || return 0
  log_step "Checking for a digest run in flight..."
  # Exit 3, as in pause_schedule: no Temporal on the box yet, so nothing can be running on it.
  local cmd="test -x $SCHEDULE_CTL || exit 3; $TEMPORAL_CLI workflow list --query '$RUNNING_DIGESTS_QUERY' -o json"
  dry_run_skip "bin/ssh \"$cmd\"" && return 0

  local out rc=0 ids
  out=$("$SCRIPT_DIR/ssh" "$cmd") || rc=$?
  if [[ $rc == 3 ]]; then
    log_info "Temporal not provisioned on the box yet -- no run to wait for"
    return 0
  fi
  # A run whose workflow task keeps failing (a nondeterminism error) carries the server's
  # TemporalReportedProblems search attribute, and it cannot take a signal.
  if [[ $rc == 0 ]] && ids=$(python3 -c '
import json, sys
runs = json.load(sys.stdin)
if not isinstance(runs, list):
    sys.exit(1)
def label(r):
    stuck = "TemporalReportedProblems" in ((r.get("searchAttributes") or {}).get("indexedFields") or {})
    return r["execution"]["workflowId"] + (" (stuck: its workflow task keeps failing)" if stuck else "")
print(", ".join(label(r) for r in runs))
' <<<"$out" 2>/dev/null); then
    if [[ -z $ids ]]; then
      log_success "no digest run in flight"
      return 0
    fi
    temporal_problem "digest workflow(s) running: $ids" \
      "deploy when they end; a run in its hold: approve or reject it; a stuck run (workflow-task failures) cannot take a signal: terminate it with bin/ssh \"$TEMPORAL_CLI workflow terminate -w <id> --reason <why>\""
    return
  fi
  temporal_problem "could not list the running digest workflows (exit $rc): $(printf '%.200s' "${out:-<no output>}")" \
    "refusing rather than guessing"
}

pause_schedule() {
  temporal_on || return 0
  log_step "Pausing the Temporal schedule..."
  # Marked paused in a dry run too, so the preview shows the resume that pairs with it.
  dry_run_skip "bin/ssh $SCHEDULE_CTL pause" && { SCHEDULE_PAUSED=true; return 0; }

  local out rc=0
  # Exit 3 is "Temporal is not on the box yet": the first deploy that carries it has nothing to
  # pause, and that is not a failure.
  out=$("$SCRIPT_DIR/ssh" "test -x $SCHEDULE_CTL || exit 3; $SCHEDULE_CTL pause 'deploy ${SHA:0:7}'" 2>&1) || rc=$?
  case $rc in
    0)
      SCHEDULE_PAUSED=true
      log_success "${out##*$'\n'}"
      check_no_run_in_flight || return 1
      ;;
    3) log_info "Temporal not provisioned on the box yet -- no schedule to pause" ;;
    # Unpaused, a run can start under the restart, and whatever failed the pause likely hides a
    # live run too. --force is for the deploy that repairs Temporal.
    *) temporal_problem "could not pause the Temporal schedule (exit $rc), so it stays armed: ${out:0:300}" "refusing" ;;
  esac
}

# Runs are pinned to the build that started them, and start on the deployment's current version. The
# apply restarts the bootstrap before the workers, and its missed-day trigger can start a run; with the
# old build still current that run pins to the old build and is stranded by the worker restart. So
# before the apply, current points at the build this deploy ships, which has no worker yet: a run
# started in between waits for it (digest/src/deployment.test.ts). --allow-no-pollers because the
# new worker does not exist yet, --ignore-missing-task-queues because it has never polled `digest`.
# With --skip-build the build is whatever :latest carries, unknown here, so the gap stays open.
CURRENT_MOVED=false
point_current_at_new_build() {
  temporal_on || return 0
  if [[ $SKIP_BUILD == true ]]; then
    log_info "--skip-build: the running build stays current until after the apply"
    return 0
  fi
  log_step "Pointing the current worker version at ${SHA:0:7}, before its worker exists..."
  local cmd="test -x $SCHEDULE_CTL || exit 3; $TEMPORAL_CLI worker deployment set-current-version --deployment-name digest --build-id ${SHA:0:7} --allow-no-pollers --ignore-missing-task-queues --yes"
  dry_run_skip "bin/ssh \"$cmd\"" && { CURRENT_MOVED=true; return 0; }

  local out rc=0
  out=$("$SCRIPT_DIR/ssh" "$cmd" 2>&1) || rc=$?
  case $rc in
    0) CURRENT_MOVED=true; log_success "current version: digest:${SHA:0:7} (no worker until the apply)" ;;
    3) log_info "Temporal not provisioned on the box yet -- no deployment to point" ;;
    # Not fatal: the version is made current after the apply either way; only the gap stays open.
    *) log_error "could not point the current version at ${SHA:0:7} (exit $rc): ${out:0:300} -- a run the apply's bootstrap starts would be stranded (runbook, \"Stranded runs\")" ;;
  esac
}

# The new worker polls as its own build and gets no run until that build is the deployment's current
# version, so this sits after the apply and before the schedule is restored. It runs inside the
# running worker container (digest/src/cli/set-current.ts), so the build made current is the one
# running, whatever --skip-build left there, and it waits until that worker polls. Exit 2: current,
# but runs pinned to another build were found, whose worker this deploy stopped (runbook, "Stranded
# runs"). The exit trap runs it too after a failure, to point current back at whichever worker runs.
WORKER_CONTAINER="news-digest-worker" # terraform's news-digest-worker.service
set_current_version() {
  temporal_on || return 0
  log_step "Making the running worker's build the current version..."
  local cmd="for i in \$(seq 60); do docker exec $WORKER_CONTAINER true 2>/dev/null && break; sleep 2; done; docker exec $WORKER_CONTAINER node dist/cli/set-current.js"
  dry_run_skip "bin/ssh \"$cmd\"" && { CURRENT_MOVED=false; return 0; }

  local out rc=0 build
  CURRENT_MOVED=true # until the running build is confirmed current
  out=$("$SCRIPT_DIR/ssh" "$cmd" 2>&1) || rc=$?
  # 0, 2 and 3 all mean the running build is current.
  [[ $rc == 0 || $rc == 2 || $rc == 3 ]] && CURRENT_MOVED=false
  case $rc in
    0) log_success "${out%%$'\n'*}" ;;
    3) log_error "${out%%$'\n'*}, but the running digests could not be checked for stranded runs: ${out#*$'\n'}" ;;
    2)
      build=$(sed -n 's/^current version: digest:\(.*\)$/\1/p' <<<"$out")
      log_error "the new build ($build) is current, but these runs are pinned to a build with no worker and will sit: $(grep '^stranded:' <<<"$out" | tr '\n' ' ')"
      log_error "move each onto the new build: bin/ssh \"$TEMPORAL_CLI workflow update-options -w <id> --versioning-override-behavior pinned --versioning-override-deployment-name digest --versioning-override-build-id $build\" -- it replays on the new code; a nondeterminism error there means terminate it and start the day again (runbook, \"Stranded runs\")"
      # A stalled rehearsal must not fail Python's deploy; a stalled live run is today's digest.
      [[ $PIPELINE_MODE == staged ]]
      ;;
    *)
      log_error "the new worker's build is NOT the current version, so no run will start on it (exit $rc): ${out:0:300} -- once the worker polls: bin/ssh docker exec $WORKER_CONTAINER node dist/cli/set-current.js"
      # A run started meanwhile (the apply's bootstrap) is pinned to nothing; it starts once a build
      # whose worker polls is current (digest/src/deployment.ts, waitingRuns).
      local waiting
      waiting=$(sed -n 's/^waiting: \(.*\) -- no worker has taken.*/\1/p' <<<"$out")
      [[ -n $waiting ]] && log_error "no worker has taken digest run(s) $waiting yet; each starts once a polling build is current (the set-current.js above)"
      return 1
      ;;
  esac
}

# The bootstrap unit, not a bare unpause: it knows the mode, so a "staged" deploy leaves the
# schedule paused, and in "temporal" it starts today's run once if 12:25 Europe/Paris passed while paused. It
# also re-runs ensureSchedule from the new image.
resume_schedule() {
  [[ $SCHEDULE_PAUSED == true ]] || return 0
  log_step "Restoring the Temporal schedule's state..."
  dry_run_skip "bin/ssh systemctl restart $SCHEDULE_BOOTSTRAP_UNIT" && { SCHEDULE_PAUSED=false; return 0; }

  if "$SCRIPT_DIR/ssh" "systemctl restart $SCHEDULE_BOOTSTRAP_UNIT"; then
    SCHEDULE_PAUSED=false
    log_success "Temporal schedule restored for the live pipeline"
    return 0
  fi
  log_error "the Temporal schedule is still PAUSED -- restore it with: bin/ssh systemctl restart $SCHEDULE_BOOTSTRAP_UNIT"
  return 1
}

TF_TARGETS=(
  -target=null_resource.news_digest_env
  # Named explicitly even though news_digest_service depends_on it, so a targeted apply would
  # pull it in anyway. Relying on that is how a resource gets left behind the next time the
  # dependency is reworked -- the same "update every reference" miss that has bitten renames here.
  -target=null_resource.news_digest_v6_network
  -target=null_resource.news_digest_service
  -target=null_resource.news_digest_timer
  # Added with digest pinning: this unit embeds local.news_digest_image, so its script hash now
  # changes on every deploy. Left untargeted it would keep running whatever image it was last
  # written with -- eventually a digest that registry GC has pruned.
  -target=null_resource.news_digest_health_check
  -target=null_resource.news_digest_alert
  -target=null_resource.news_digest_deadman
  -target=null_resource.digest_server
)

# The TypeScript pipeline (news-digest-temporal.tf), targeted only when the box runs it. Tearing it
# down (staged -> python) is a deliberate targeted apply in the runbook, never a side effect here.
TF_TEMPORAL_TARGETS=(
  -target=null_resource.news_digest_temporal_db
  -target=null_resource.news_digest_temporal_server
  -target=null_resource.news_digest_temporal_bootstrap
  -target=null_resource.news_digest_workers
  -target=null_resource.news_digest_temporal_backup
)

apply_terraform() {
  log_step "Applying Terraform..."
  dry_run_skip "$INFRA_DIR/bin/tf apply" && return 0

  # Empty when --skip-build ran (nothing was pushed this time); terraform falls back to :latest,
  # which is the pre-existing behaviour rather than a hard failure on a build-less apply.
  local newsroom_digest circulation_digest worker_digest python_digest site_digest
  newsroom_digest=$(cat "$DIGEST_DIR/$SERVICE_NEWSROOM.digest" 2>/dev/null || echo "")
  circulation_digest=$(cat "$DIGEST_DIR/$SERVICE_CIRCULATION.digest" 2>/dev/null || echo "")
  worker_digest=$(cat "$DIGEST_DIR/$SERVICE_WORKER.digest" 2>/dev/null || echo "")
  python_digest=$(cat "$DIGEST_DIR/$SERVICE_PYTHON.digest" 2>/dev/null || echo "")
  site_digest=$(cat "$DIGEST_DIR/$SERVICE_SITE.digest" 2>/dev/null || echo "")

  local -a targets=("${TF_TARGETS[@]}") vars=()
  temporal_on && targets+=("${TF_TEMPORAL_TARGETS[@]}")
  # The importer terraform ships to the box (staged refresh, cut-over import), from the checkout that
  # built the worker image rather than terraform's default sibling checkout. Only where the Temporal
  # stack is on: python-mode infra need not declare the variable, and terraform refuses a value for
  # an undeclared one.
  temporal_on && vars+=(-var="news_digest_import_legacy_path=$(cd "$SCRIPT_DIR/.." && pwd)/bin/import-legacy")

  local plan_output plan_exit
  # A plan file left by an interrupted deploy would pass the exit-1 check below and be applied.
  rm -f /tmp/news-digest-tfplan
  set +e
  plan_output=$("$INFRA_DIR/bin/tf" plan \
    "${targets[@]}" \
    -var="news_digest_deploy_sha=$SHA" \
    -var="news_digest_newsroom_digest=$newsroom_digest" \
    -var="news_digest_circulation_digest=$circulation_digest" \
    -var="news_digest_worker_digest=$worker_digest" \
    -var="news_digest_python_digest=$python_digest" \
    -var="news_digest_site_digest=$site_digest" \
    "${vars[@]}" \
    -detailed-exitcode \
    -out=/tmp/news-digest-tfplan \
    -compact-warnings \
    -no-color 2>&1)
  plan_exit=$?
  set -e

  if [[ $plan_exit -eq 0 ]]; then
    log_info "No Terraform changes -- skipping apply"
    rm -f /tmp/news-digest-tfplan
    return 0
  fi

  if [[ $plan_exit -ne 2 ]]; then
    # Terraform 1.14+ returns exit 1 instead of 2 when -target warnings
    # are present, even with -detailed-exitcode. A valid plan file means
    # the plan succeeded despite the wrong exit code.
    if [[ $plan_exit -eq 1 && -f /tmp/news-digest-tfplan ]]; then
      log_info "Plan has changes (exit 1 with valid plan file -- terraform warning bug)"
    else
      echo "$plan_output" >&2
      log_error "terraform plan failed (exit $plan_exit)"
      rm -f /tmp/news-digest-tfplan
      return 1
    fi
  fi

  echo "$plan_output" | grep -E "^(Plan:|No changes\.)" || true
  log_step "Changes detected, applying..."
  run_quiet "$INFRA_DIR/bin/tf" apply -auto-approve /tmp/news-digest-tfplan
  rm -f /tmp/news-digest-tfplan

  log_success "Terraform applied"
}

# The box's weekly cleanup (seanfloyd.dev scripts/server/cleanup.sh) runs `docker image prune -af`,
# which removes every image no container references. The newsroom image runs only as a one-shot
# --rm container, and a replaced worker's or site's image is referenced by nothing, so without this
# a rollback by digest must pull from the registry. One stopped container per pushed image, labelled
# by repository, holds it; `docker ps` lists newest first, so all but the newest KEEP_IMAGES of a
# repository are removed. Redeploying a digest recreates its container, making it the newest.
# The names stay clear of the site sweeps' ^digest-circulation-, ^digest-site- and ^digest-next-.
# Not fatal: the deploy is live by now, and a failure costs only the registry-free rollback.
KEEP_IMAGES=3
KEEP_LABEL="news-digest.keep"
keep_images_on_box() {
  dry_run_skip "bin/ssh: a stopped $KEEP_LABEL container per pushed image, newest $KEEP_IMAGES per repository" && return 0
  local -a digests=("$DIGEST_DIR"/*.digest)
  [ -e "${digests[0]}" ] || return 0
  log_step "Keeping the last $KEEP_IMAGES images of each repository on the box..."

  local cmd="fail=0" file name dg cname
  for file in "${digests[@]}"; do
    name=$(basename "$file" .digest)
    dg=$(cat "$file")
    cname="news-digest-keep-$name-${dg:7:12}"
    cmd+="; docker rm -f $cname >/dev/null 2>&1; docker create --name $cname --label $KEEP_LABEL=$name $REGISTRY/$name@$dg >/dev/null || fail=1"
    cmd+="; docker ps -a --filter label=$KEEP_LABEL=$name --format '{{.Names}}' | tail -n +$((KEEP_IMAGES + 1)) | xargs -r docker rm >/dev/null || fail=1"
  done
  cmd+="; exit \$fail"

  local out rc=0
  out=$("$SCRIPT_DIR/ssh" "$cmd" 2>&1) || rc=$?
  if [[ $rc == 0 ]]; then
    log_success "the box holds the last $KEEP_IMAGES images of ${#digests[@]} repositories for rollback"
  else
    log_error "images NOT kept for rollback on the box (exit $rc): ${out:0:300} -- the weekly prune may remove them, and a rollback would then pull from the registry"
  fi
  return 0
}

# ============================================
# Post-deploy MCP contract smoke
# ============================================

# The web gate grades pages the way a browser sees them. The MCP surface is JSON-RPC that no
# page links to, so nothing else would notice it 404ing. Three GETs and one POST against prod,
# after the apply: the card, its alias and the GET catalogue must be served, tools/list must
# answer, and the tool names in all four must be identical. Every list comes from one function
# in one binary, so a difference cannot be a code drift; what it catches is the proxy or a
# regressed route serving something else on one of the four paths (an interstitial, the HTML
# 404 page) -- and the check refuses an empty list on every side, so "all paths serve garbage"
# fails too, not just "one does".
# Runs after the deploy is live and tagged, so a failure here is loud but not a rollback: the
# fix is a forward deploy, and the deployment is marked failed so the record says it was not
# verified. Needs jq, like the SBOM gate; checked here because --skip-build skips that gate.
# Takes an explicit base URL for testing the function outside a deploy (see docs/lessons).
site_smoke() {
  local url="$1" today path
  log_step "Smoking the site on $url..."
  dry_run_skip "curl $url/health, /, /feed.xml, /issues/<latest>, its .md" && return 0
  if ! wait_for_condition "site answering" 180 curl -fsS -o /dev/null --max-time 2 "$url/health"; then
    log_error "the site is not answering on $url/health"
    return 1
  fi
  # The newest issue, from the feed the site serves (not today's date: before 10:25Z today has none).
  today=$(curl -fsS --max-time 15 "$url/feed.xml" | grep -oE '/issues/[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1) || today=""
  if [ -z "$today" ]; then
    log_error "the site's feed names no issue at $url/feed.xml"
    return 1
  fi
  for path in / "$today" "$today.md"; do
    if ! curl -fsS -o /dev/null --max-time 15 "$url$path"; then
      log_error "the site does not serve $url$path"
      return 1
    fi
  done
  log_success "site serving on $url: health, home, feed, $today and its Markdown"
}

mcp_smoke() {
  local url="${1:-}"
  if [ -z "$url" ]; then
    # The domain comes from terraform, the thing that just deployed, not from .env: .env's
    # DIGEST_DOMAIN is this machine's local OrbStack name, and a dry run showed the smoke
    # about to probe it. No fallback -- a smoke that cannot name prod must say so, not skip.
    local domain
    domain=$(echo 'var.news_digest_domain' | "$INFRA_DIR/bin/tf" console 2>/dev/null | tr -d '"[:space:]') || domain=""
    # The capture must LOOK like a hostname, not merely be non-empty. On 2026-09-04 a
    # terraform "value for undeclared variable" warning came back on stdout, survived
    # 2>/dev/null, and was whitespace-stripped into the domain -- so the smoke curled a URL
    # built from the warning text and reported "circulation is not answering" while the site
    # was serving 200s. A smoke that cannot tell "prod is down" from "I built a bad URL" is
    # worse than no smoke, because it is believed.
    if [ -z "$domain" ] || ! printf '%s' "$domain" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$'; then
      log_error "var.news_digest_domain did not resolve to a hostname -- MCP contract unverified (got: '$(printf '%.60s' "${domain:-<empty>}")')"
      return 1
    fi
    url="https://$domain"
  fi

  # The TypeScript site retired /mcp and /ask (docs/2026-09-24-web-tier-and-ops-decisions.md): in
  # temporal mode the smoke is the pages readers and agents fetch, not the MCP contract.
  if [[ ${PIPELINE_MODE:-python} == temporal ]]; then
    site_smoke "$url"
    return
  fi

  log_step "Smoking the MCP contract on $url..."
  dry_run_skip "curl $url/.well-known/mcp.json, POST $url/mcp tools/list" && return 0
  command -v jq &>/dev/null || { log_error "jq not installed -- cannot verify the MCP contract"; return 1; }

  # 180s, not 60: under the old attempt-counting loop a 60 meant ~180s of wall clock with
  # this probe, and nothing here has measured how long circulation takes to answer after a
  # restart. Keep the budget that has been passing deploys; shorten it only against a measurement.
  if ! wait_for_condition "circulation answering" 180 curl -fsS -o /dev/null --max-time 2 "$url/health"; then
    log_error "circulation is not answering on $url/health"
    return 1
  fi

  # Each curl and each jq is its own statement, never a pipeline: set -e sees only a pipeline's
  # last command, so `jq | sort` would turn a parse failure into an empty list that happens to
  # equal another empty list.
  local served_json card served
  local card_json legacy_json tools_json legacy tools
  card_json=$(curl -fsS --max-time 15 "$url/.well-known/mcp.json") || {
    log_error "MCP card not served at $url/.well-known/mcp.json"
    return 1
  }
  # The directory-shaped alias and the GET bridge's catalogue are separate proxy paths from
  # the file-shaped card; a rule that matches one and not the other is the failure this
  # check is for, so all three GET doors are fetched, not one.
  legacy_json=$(curl -fsS --max-time 15 "$url/.well-known/mcp/server-card.json") || {
    log_error "MCP card alias not served at $url/.well-known/mcp/server-card.json"
    return 1
  }
  tools_json=$(curl -fsS --max-time 15 "$url/mcp/tools.json") || {
    log_error "MCP tool catalogue not served at $url/mcp/tools.json"
    return 1
  }
  served_json=$(curl -fsS --max-time 15 "$url/mcp" \
    -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}') || {
    log_error "POST $url/mcp tools/list failed"
    return 1
  }
  card=$(jq -er '.tools[].name' <<<"$card_json") || {
    log_error "MCP card has no tools[] -- got: ${card_json:0:200}"
    return 1
  }
  legacy=$(jq -er '.tools[].name' <<<"$legacy_json") || {
    log_error "MCP card alias has no tools[] -- got: ${legacy_json:0:200}"
    return 1
  }
  tools=$(jq -er '.tools[].name' <<<"$tools_json") || {
    log_error "MCP tool catalogue has no tools[] -- got: ${tools_json:0:200}"
    return 1
  }
  served=$(jq -er '.result.tools[].name' <<<"$served_json") || {
    log_error "tools/list answered without result.tools[] -- got: ${served_json:0:200}"
    return 1
  }
  if [ -z "$card" ] || [ -z "$legacy" ] || [ -z "$tools" ] || [ -z "$served" ]; then
    log_error "MCP contract empty on $url -- card: ${#card}, alias: ${#legacy}, catalogue: ${#tools}, tools/list: ${#served} bytes"
    return 1
  fi
  served=$(sort <<<"$served")
  local name doc
  for name in card legacy tools; do
    doc=$(sort <<<"${!name}")
    if [ "$doc" != "$served" ]; then
      log_error "MCP contract drift on $url -- $name (<) vs tools/list (>):"
      diff <(printf '%s\n' "$doc") <(printf '%s\n' "$served") >&2 || true
      return 1
    fi
  done
  log_success "MCP contract intact on $url: $(printf '%s\n' "$served" | wc -l | tr -d ' ') tools; card, alias and catalogue == tools/list"
}

# ============================================
# Cleanup
# ============================================

DEPLOYMENT_SUCCEEDED=false

cleanup() {
  local exit_code=$?

  [[ $DEPLOYMENT_SUCCEEDED == false ]] && \
    update_deployment_status "failure" "Deployment failed (exit $exit_code)"

  # Current may name a build no worker runs (pointed at before the apply, or never confirmed after
  # it): point it at whichever worker runs. If none can be, a run the schedule starts would sit with no
  # alert, so the schedule stays paused, loudly.
  if [[ $CURRENT_MOVED == true ]] && ! set_current_version && [[ $SCHEDULE_PAUSED == true ]]; then
    log_error "the Temporal schedule stays PAUSED: no running worker's build could be made current. Once the worker polls: bin/ssh docker exec $WORKER_CONTAINER node dist/cli/set-current.js, then bin/ssh systemctl restart $SCHEDULE_BOOTSTRAP_UNIT"
    SCHEDULE_PAUSED=false
  fi

  # A deploy that died after pausing must not leave tomorrow's run silently disarmed. Resuming
  # re-arms whatever is on the box, which is what the Python timer (never paused) does too.
  if [[ $SCHEDULE_PAUSED == true ]]; then
    log_error "deploy stopped with the Temporal schedule paused -- restoring it"
    resume_schedule || true
  fi

  [[ -n $DIGEST_DIR && -d $DIGEST_DIR ]] && rm -rf "$DIGEST_DIR"

  if [[ -f $TAILSCALE_MARKER ]]; then
    log_info "Closing Tailscale (started by this deploy)..."
    osascript -e 'quit app "Tailscale"' 2>/dev/null || true
    rm -f "$TAILSCALE_MARKER"
  fi

  exit "$exit_code"
}
trap cleanup EXIT

# ============================================
# Main
# ============================================

main() {
  log_stage "DEPLOYMENT STARTING"

  if [[ $DRY_RUN == true ]]; then
    log_info "DRY RUN MODE - no changes will be made"
    echo ""
  fi

  derive_config
  if [ -n "$ROLLBACK_TAG" ]; then
    load_rollback || exit 1
  fi

  # Pre-flight checks
  log_stage "PRE-FLIGHT CHECKS"
  check_docker || exit 1
  check_tailscale || exit 1
  check_web || exit 1
  read_pipeline_mode || exit 1
  check_box_matches_mode || exit 1
  check_database_url || exit 1
  check_run_window || exit 1
  check_no_run_in_flight || exit 1

  # Git operations
  log_stage "GIT OPERATIONS"
  push_to_github
  create_deployment

  # Build and deploy
  log_stage "BUILD & DEPLOY"

  if [[ $AUTO_APPROVE == false && $DRY_RUN == false ]]; then
    echo ""
    echo "About to:"
    [[ -n $ROLLBACK_TAG ]] && echo "  - ROLL BACK to $ROLLBACK_TAG (${SHA:0:7}): its images by digest, no build, no migrations"
    [[ $SKIP_BUILD == false ]] && echo "  - Build and push Docker images"
    echo "  - Apply Terraform (news_digest_env, news_digest_service, news_digest_alert, news_digest_deadman, digest_server)"
    if temporal_on; then
      echo "  - Pipeline mode $PIPELINE_MODE: build the Temporal workers and the site image, pause the schedule for the deploy and restore it"
      echo "    after, apply the Temporal stack (news_digest_temporal_db/_server/_bootstrap/_backup, news_digest_workers),"
      echo "    and make the new worker's build the current version"
    fi
    echo "  - Run database migrations"
    echo ""
    read -p "Continue? [y/N] " -n 1 -r
    echo
    [[ ! $REPLY =~ ^[Yy]$ ]] && echo "Aborted." && exit 1
  fi

  # Explicit `|| exit 1` rather than leaning on set -e: this is the file's convention for a gate
  # (see verify_provenance below), and build_and_push now fails for a reason other than a build.
  build_and_push || exit 1
  # generate_sbom (inside build_and_push) gates on vulnerabilities BEFORE its own image is pushed,
  # so a blocked image never reaches the registry. The builds run concurrently, though, so the
  # OTHER service's :latest may already have moved when one aborts -- a mixed pair that
  # `--skip-build` would then ship. verify_provenance sits here for the same reason: still ahead of
  # anything deployed or migrated.
  verify_provenance || exit 1
  # Ahead of the snapshot and the migrations: nothing may start a run against a database that is
  # about to be copied and then mutated.
  pause_schedule || exit 1
  point_current_at_new_build
  backup_data
  # Migrations BEFORE terraform: circulation fail-closes at boot on missing
  # required tables (REQUIRED_TABLES), and terraform restarts it. Migrating
  # first means the new container boots against an already-migrated DB; the
  # old, still-running services ignore the (additive) new tables. The old
  # order took the site down: new circulation crash-looped on the missing
  # table, kamal-proxy's health check failed, terraform aborted, and
  # run_migrations was never reached. run_migrations pulls the freshly
  # pushed newsroom image itself, so it does not depend on apply_terraform.
  run_migrations || exit 1
  apply_terraform
  keep_images_on_box
  tag_deployment
  # After the tag, like the smoke: the deploy is live whether or not these succeed, and a failure
  # here must not orphan the tag that records its digests. The trap still restores the schedule.
  set_current_version || exit 1
  resume_schedule || exit 1
  # Deploy is LIVE and its image digests are tagged from here; the smoke verifies it rather
  # than gating it (see mcp_smoke), and must not sit ahead of the tag it would orphan.
  mcp_smoke || exit 1

  # Success
  DEPLOYMENT_SUCCEEDED=true
  update_deployment_status "success" "Deployed ${SHA:0:7}"

  log_stage "DEPLOYMENT COMPLETE"
  echo ""
  echo -e "${GREEN}${BOLD}✓ Successfully deployed news-digest${RESET}"
  echo ""

  # Check for dependency updates
  [[ -x "$SCRIPT_DIR/check-versions" ]] && "$SCRIPT_DIR/check-versions" --quiet || true
}

# Sourced by bin/tests/test_deploy_run_guard.py, which calls the guard functions alone.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main
fi
