#!/usr/bin/env bash
# usage: bin/site-parity-record [SRC]
#
# Records the Rust circulation server's answer to every request in digest/src/site/parity/requests.ts,
# served from a copy of SRC (default data/prod-20260923b.db), into data/site-parity/<stamp>/golden: the
# goldens the TypeScript site is held to (docs/2026-09-23-web-tier-typescript-fork.md §5). The copy is
# kept beside them as legacy.db, so the same data can be imported into Postgres for the other side.
# Everything it starts is named digest-site-parity-* and removed on exit.
set -euo pipefail
cd "$(dirname "$0")/.."
src=${1:-data/prod-20260923b.db}
[ -r "$src" ] || { echo "site-parity-record: cannot read $src (make db-clone)" >&2; exit 2; }
dir=data/site-parity/$(date -u +%Y%m%dT%H%M%SZ)
p=digest-site-parity
cleanup() {
  docker rm -f "$p-rust" >/dev/null 2>&1 || true
  docker network rm "$p" >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

mkdir -p "$dir/golden"
cp -c "$src" "$dir/legacy.db"
# What the goldens are reproducible from: the database's bytes and the circulation tree the image was
# built from (dirty when circulation/ has uncommitted changes).
sha=$(shasum -a 256 "$dir/legacy.db" | cut -d' ' -f1)
commit=$(git rev-parse HEAD)
dirty=false
[ -z "$(git status --porcelain -- circulation newsroom/sources.json design)" ] || dirty=true
provenance="{\"source\":\"$src\",\"sha256\":\"$sha\",\"commit\":\"$commit\",\"circulation_dirty\":$dirty}"
docker build -q -f circulation/Dockerfile -t "$p-circulation:local" . >/dev/null
docker build -q -f digest/Dockerfile --build-arg GIT_SHA=parity -t "$p-digest:local" . >/dev/null
docker network create "$p" >/dev/null
docker run -d --name "$p-rust" --network "$p" -v "$PWD/$dir:/data:ro" -e DATABASE_PATH=/data/legacy.db \
  --env-file digest/src/site/parity/site.env "$p-circulation:local" >/dev/null
# 127.0.0.1, not localhost: busybox wget tries ::1 first and the server binds IPv4 only.
for _ in $(seq 60); do
  docker exec "$p-rust" wget -q -O /dev/null http://127.0.0.1:8080/health 2>/dev/null && break
  sleep 1
done
docker exec "$p-rust" wget -q -O /dev/null http://127.0.0.1:8080/health 2>/dev/null \
  || { echo "site-parity-record: the Rust server never answered /health" >&2; docker logs "$p-rust" | tail -20 >&2; exit 1; }
docker run --rm --network "$p" -v "$PWD/$dir/golden:/out" -e RECORD_PROVENANCE="$provenance" "$p-digest:local" \
  node dist/cli/site-parity.js record "http://$p-rust:8080" /out
echo "goldens: $dir/golden (SITE_PARITY_DIR=$dir)"
