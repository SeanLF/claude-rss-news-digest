#!/bin/bash
# SELECT order-dependence harness (arXiv 2608.26762 applied to our SELECT stage).
# Runs the real .claude/agents/select.md through the production agent-sdk path, N reps in the
# archived cluster order vs N reps on permuted clusters, and compares within-arm Jaccard.
# Makes REAL model calls on the subscription (~$0.4 a rep) -- opt-in, never in CI.
#
# Usage:
#   bin/eval-select-order fetch RUN_ID            pull one prod run's SELECT inputs (via bin/ops)
#   bin/eval-select-order run RUN_ID [args...]    e.g. --reps 5 --arms fixed,shuffled,sorted; --check = negative control only
#   bin/eval-select-order rescore SUMMARY_JSON     recompute a stored run's statistics, no model calls (--in-place to rewrite)
# Fixtures and per-rep answers live under gitignored scratch/select-order/.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

cmd="${1:-}"; run_id="${2:-}"
[[ -n "$cmd" && -n "$run_id" ]] || { sed -n '2,11p' "$0"; exit 2; }
fx="scratch/select-order/run$run_id"

case "$cmd" in
  rescore)
    summary="$run_id"; shift 2
    [[ -f "$summary" ]] || { echo "no such file: $summary" >&2; exit 2; }
    dir="$(cd "$(dirname "$summary")" && pwd)"
    exec docker compose run --rm \
      -v "$dir:/app/rescore" \
      -v "$(pwd)/newsroom/src:/app/src" \
      -e PYTHONPATH=/app/src \
      --entrypoint /app/.venv/bin/python3 \
      digest-newsroom /app/src/eval_select_order.py --rescore "/app/rescore/$(basename "$summary")" "$@"
    ;;
  fetch)
    mkdir -p "$fx"
    rm -f "$fx/.fetched"   # a half-finished fetch must not pass as a fixture
    for name in clusters.json recap.txt selected.json; do
      bin/ops artifact "$run_id" "$name" > "$fx/$name"
    done
    # Optional in select.md, and runs before 245 did not archive it: absent, not empty.
    bin/ops artifact "$run_id" yesterday_headlines.txt > "$fx/yesterday_headlines.txt" \
      || { rm -f "$fx/yesterday_headlines.txt"; echo "run $run_id has no yesterday_headlines.txt; running without it" >&2; }
    # articles_N.csv: the count varies by run, so take whatever the run archived.
    names=$(bin/ops artifacts "$run_id" | jq -r '.rows[].artifact_name | select(startswith("articles_"))')
    [[ -n "$names" ]] || { echo "run $run_id archived no articles_*.csv; refusing a fixture SELECT could not read" >&2; exit 1; }
    for name in $names; do bin/ops artifact "$run_id" "$name" > "$fx/$name"; done
    # sources.csv is not archived; write it as prepare.py does (catalogue minus parked entries,
    # csv.writer's minimal quoting) rather than approximating it with jq.
    python3 - "$fx/sources.csv" <<'PY'
import csv, json, sys
rows = json.load(open("newsroom/sources.json"))
rows = rows["sources"] if isinstance(rows, dict) else rows
with open(sys.argv[1], "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["id", "name", "bias", "factuality", "perspective"])
    for s in rows:
        if s.get("active", True) is False:
            continue
        w.writerow([s["id"], s["name"], s["bias"], s["factuality"], s["perspective"]])
PY
    touch "$fx/.fetched"
    ls -la "$fx"
    ;;
  run)
    shift 2
    [[ -f "$fx/.fetched" ]] || { echo "no complete fixture at $fx (fetch failed or never ran); run: $0 fetch $run_id" >&2; exit 2; }
    mkdir -p "$fx/work"
    exec docker compose run --rm \
      -v "$(pwd)/$fx:/app/eval-fixtures" \
      -v "$(pwd)/$fx/work:/app/eval-work" \
      -v "$(pwd)/newsroom/src:/app/src" \
      -v "$(pwd)/.claude/agents:/app/.claude/agents" \
      -e PYTHONPATH=/app/src \
      --entrypoint /app/.venv/bin/python3 \
      digest-newsroom /app/src/eval_select_order.py "$@"
    ;;
  *) sed -n '2,11p' "$0"; exit 2 ;;
esac
