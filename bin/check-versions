#!/usr/bin/env python3
"""Check for available updates. Usage: bin/check-versions [--strict] [--quiet]"""

import json, os, re, shutil, subprocess, sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from urllib.request import urlopen

GREEN, YELLOW, RED, BOLD, RESET = ("\033[32m", "\033[33m", "\033[31m", "\033[1m", "\033[0m") if sys.stdout.isatty() else ("",) * 5
STRICT, QUIET = "--strict" in sys.argv, "--quiet" in sys.argv or os.environ.get("CLAUDECODE") == "1"

def fetch(url):
    try:
        with urlopen(url, timeout=10) as r: return json.loads(r.read())
    except: return None

def sh(cmd): return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()
def has(cmd): return shutil.which(cmd) is not None or sh(f"mise current {cmd} 2>/dev/null") != ""

def gh_release(repo):
    d = fetch(f"https://api.github.com/repos/{repo}/releases/latest")
    return d["tag_name"].lstrip("v") if d and "tag_name" in d else None

def gh_tag(repo):
    d = fetch(f"https://api.github.com/repos/{repo}/tags")
    if not d: return None
    vs = [t["name"] for t in d if re.match(r"^v?\d+\.\d+(\.\d+)?$", t["name"])]  # exclude alpha/beta/rc
    return max(vs, key=lambda v: [int(x) for x in re.findall(r"\d+", v)], default=None)

def alpine_latest_minor():
    """Newest Alpine release cycle (e.g. '3.24') per endoflife.date -- complete cycle list, no Docker Hub tag-churn/pagination ambiguity."""
    d = fetch("https://endoflife.date/api/alpine.json")
    if not isinstance(d, list): return None
    cycles = [c for c in (str(x.get("cycle", "")) for x in d) if re.match(r"^\d+\.\d+$", c)]
    return max(cycles, key=lambda v: [int(x) for x in v.split(".")], default=None)

def compare(name, cur, lat):
    if lat is None: return err(name, f"couldn't determine latest (have {cur})")  # don't render a fetch failure as a phantom update
    return (name, "ok" if cur.lstrip("v") == lat.lstrip("v") else "update", cur, lat, None)
def ok(name, cur): return (name, "ok", cur, None, None)
def err(name, msg): return (name, "error", msg, None, None)

# --- Checks ---

def mise_or_cmd(tool, cmd):
    """Get version from mise if available, otherwise run command."""
    ver = sh(f"mise current {tool} 2>/dev/null")
    return ver if ver else sh(cmd)

def check_python():
    cur = mise_or_cmd("python", "python3 --version").replace("Python ", "").split()[0]
    return compare("python", cur, gh_tag("python/cpython")) if cur else err("python", "not found")

def check_uv():
    # Check the Dockerfile pin (what the Python worker's image builds with), not the host
    dockerfile = Path(__file__).parent.parent / "digest" / "python" / "Dockerfile"
    if not dockerfile.exists(): return ok("uv", "(no Dockerfile)")
    m = re.search(r"ghcr\.io/astral-sh/uv:(\S+?)[\s@]", dockerfile.read_text())
    if not m: return err("uv", "can't parse Dockerfile pin")
    pin, lat = m.group(1), gh_release("astral-sh/uv")
    # The image floats on latest by design (build-time tool); show what it resolves to
    if pin == "latest": return ok("uv", f"latest → {lat}" if lat else "latest")
    return compare("uv", pin, lat)

def check_uv_host():
    if not has("uv"): return ok("uv-host", "(not installed)")
    cur = mise_or_cmd("uv", "uv --version").replace("uv ", "").split()[0]
    return compare("uv-host", cur, gh_release("astral-sh/uv")) if cur else err("uv-host", "can't parse")

def check_alpine():
    # Check the alpine base-image pin across all Dockerfiles (what gets deployed); flag drift
    root = Path(__file__).parent.parent
    pins = {}  # version -> [relative Dockerfile paths]
    for df in sorted(root.glob("*/Dockerfile*")):
        for m in re.finditer(r"FROM alpine:(\d+\.\d+)", df.read_text()):
            pins.setdefault(m.group(1), []).append(str(df.relative_to(root)))
    if not pins: return ok("alpine", "(no pin)")
    if len(pins) > 1:
        detail = [f"{v} in {', '.join(sorted(set(f)))}" for v, f in sorted(pins.items())]
        return ("alpine", "update", "pin drift across Dockerfiles", None, detail)
    return compare("alpine", next(iter(pins)), alpine_latest_minor())

def check_docker():
    if not has("docker"): return err("docker", "not installed")
    if subprocess.run("docker info", shell=True, capture_output=True).returncode != 0: return err("docker", "not running")
    m = re.search(r"(\d+\.\d+\.\d+)", sh("docker --version"))
    return ok("docker", m.group(1) if m else "?")

def check_orbstack():
    if not Path("/Applications/OrbStack.app").is_dir(): return ok("orbstack", "(not installed)")
    cur = sh("defaults read /Applications/OrbStack.app/Contents/Info.plist CFBundleShortVersionString")
    lat = re.search(r": ([\d.]+)", sh("brew info --cask orbstack"))
    return compare("orbstack", cur, lat.group(1) if lat else cur)

def check_tailscale():
    if not has("tailscale"): return err("tailscale", "not installed")
    cur = sh("tailscale version").split("\n")[0].strip()
    return compare("tailscale", cur, gh_release("tailscale/tailscale")) if cur and cur[0].isdigit() else err("tailscale", "not running")

def pypi_ver(pkg):
    d = fetch(f"https://pypi.org/pypi/{pkg}/json")
    return d["info"]["version"] if d else None

def check_python_deps():
    # Check the Python worker's uv.lock versions against PyPI (what gets deployed)
    lockfile = Path(__file__).parent.parent / "digest" / "python" / "uv.lock"
    pyproject = Path(__file__).parent.parent / "digest" / "python" / "pyproject.toml"
    if not lockfile.exists(): return err("py-deps", "no uv.lock")
    if not pyproject.exists(): return err("py-deps", "no pyproject.toml")
    # Match dependency names whether they carry a version specifier OR are bare (`"name"`). The
    # old pattern required a `[><=!~[` terminator, so it silently skipped every BARE dep, quietly
    # checking nothing.
    direct = set(re.findall(r'"([A-Za-z][\w.-]+?)(?:[><=!~\[]|")', pyproject.read_text()))
    locked = dict(re.findall(r'^name = "(.+?)"\nversion = "(.+?)"', lockfile.read_text(), re.MULTILINE))
    deps = [(n, locked[n]) for n in direct if n in locked]
    def norm(v): parts = [int(x) for x in v.split(".")]; return parts + [0] * (3 - len(parts))
    outdated = [(n, c, l) for n, c in deps if (l := pypi_ver(n)) and norm(c) < norm(l)]
    if not outdated: return ok("py-deps", "checked")
    return ("py-deps", "update", f"{len(outdated)} outdated", None, [f"{n}: {c} → {l}" for n, c, l in outdated])

def check_python_base():
    """The Python worker's base image (python:X.Y-slim, pinned by digest). Flags when a newer Python
    minor series is out so the pinned base can be bumped deliberately."""
    dockerfile = Path(__file__).parent.parent / "digest" / "python" / "Dockerfile"
    if not dockerfile.exists(): return ok("python-base", "(no Dockerfile)")
    m = re.search(r"FROM python:(\d+\.\d+)-slim", dockerfile.read_text())
    if not m: return err("python-base", "can't parse python:X.Y-slim base pin")
    lat = gh_tag("python/cpython")
    lat_minor = ".".join(lat.lstrip("v").split(".")[:2]) if lat else None
    return compare("python-base", m.group(1), lat_minor)

def check_claude_cli():
    """The worker runs the Claude Code CLI bundled with @anthropic-ai/claude-agent-sdk, pinned by
    digest/package-lock.json, and it lags Claude Code's release train. This line reports the latest
    CC release for AWARENESS; it is neither the pipeline's version nor a drift signal. To move the
    pipeline's CLI, bump the SDK."""
    lat = gh_release("anthropics/claude-code")
    return ok("claude-cli", f"latest CC {lat} (FYI; pipeline CLI = the pinned SDK's bundle, not this)" if lat else "?")

CHECKS = [check_python, check_uv, check_uv_host, check_alpine, check_python_base, check_claude_cli, check_docker, check_orbstack, check_tailscale, check_python_deps]

def main():
    if not QUIET: print(f"\n{BOLD}Checking dependency versions...{RESET}\n")

    with ThreadPoolExecutor(max_workers=8) as ex:
        results = sorted([f.result() for f in as_completed(ex.submit(c) for c in CHECKS)], key=lambda r: r[0])

    updates, errors = [], False
    for name, status, cur, lat, details in results:
        if status == "ok":
            if not QUIET: print(f"  {name}: {GREEN}✓{RESET} {cur}")
        elif status == "update":
            print(f"  {name}: {YELLOW}↑{RESET} {YELLOW}{cur}{RESET}{f' → {GREEN}{lat}{RESET}' if lat else ''}")
            updates.append(f"{name}: {cur}{f' → {lat}' if lat else ''}")
            if details and not QUIET:
                for d in details: print(f"      {d}")
        else:
            print(f"  {name}: {RED}✗{RESET} {cur}")
            errors = True

    print()
    if updates: print(f"{YELLOW}{BOLD}Updates available:{RESET}\n" + "\n".join(f"  • {u}" for u in updates) + "\n")
    if errors: print(f"{YELLOW}Some checks failed — results incomplete.{RESET}")
    if not updates and not errors and not QUIET: print(f"{GREEN}{BOLD}All dependencies up to date.{RESET}")
    if STRICT and updates: sys.exit(1)

if __name__ == "__main__": main()
