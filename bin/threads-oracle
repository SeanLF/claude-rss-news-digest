#!/bin/bash
# The Python thread layer as the TypeScript port's oracle. For each archived run, newsroom/tools/threads_oracle.py
# rolls the thread tables back to just before it, saves that as the TypeScript's starting point, and runs the
# Python linker, synthesis, audit and late binding from it with the model calls answered from the run's archive.
# digest/src/threads/threads.parity.test.ts replays the TypeScript from the same point and compares.
#
# Usage:
#   bin/threads-oracle RUN...                     e.g. bin/threads-oracle 300 301 302 303 304
#   DB=path/to/digest.db  (default data/digest.db, mounted read-only; never written)
#   OUT=dir               (default data/replay/threads-oracle; case dirs land at OUT/run<N>)
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

[[ $# -ge 1 ]] || { sed -n '2,10p' "$0"; exit 2; }

DB="$(cd "$(dirname "${DB:-data/digest.db}")" && pwd)/$(basename "${DB:-data/digest.db}")"
[[ -f "$DB" ]] || { echo "no database at $DB" >&2; exit 1; }
mkdir -p "${OUT:-data/replay/threads-oracle}"
OUT="$(cd "${OUT:-data/replay/threads-oracle}" && pwd)"

# A project of its own, so a parallel checkout's build cannot replace the image mid-run.
docker compose -p threads-oracle build -q digest-newsroom
IMAGE="$(docker compose -p threads-oracle config --images digest-newsroom)"

for run in "$@"; do
  mkdir -p "$OUT/run$run"
  docker run --rm -e DIGEST_DOMAIN=news-digest.seanfloyd.dev \
    -v "$(pwd)/newsroom/src:/app/src:ro" \
    -v "$(pwd)/newsroom/tools:/app/tools:ro" \
    -v "$(pwd)/.claude/agents:/app/.claude/agents:ro" \
    -v "$DB:/db/digest.db:ro" \
    -v "$OUT/run$run:/out" \
    -e PYTHONPATH=/app/src \
    --entrypoint /app/.venv/bin/python3 \
    "$IMAGE" /app/tools/threads_oracle.py --db /db/digest.db --run "$run" --out /out
done
echo "thread oracles in $OUT"
