#!/bin/bash
# Eval-floor regression gate: recompute the L1/L2 eval metrics offline and FAIL
# if they regress against the committed baseline.
#
# No model calls, no credit -- pure code + fixtures, safe in CI and on every
# change. Watches:
#   * L1 pass-rate       -- any code-assertion check flipping PASS -> FAIL
#   * L1 graded stories  -- the L1 checks passing over fewer headlines than before
#   * L2 agreement rate  -- the recorded verdicts agreeing less with the blind labels
#   * L2 fail-precision  -- the recorded fail accuracy dropping
#   * L2 leak count      -- false passes (unfaithful headlines let through) rising
#   * L2 unresolved      -- a headline citing nothing resolvable recorded as passed
#   * L2 subset sizes    -- the golden set, the blind-labelled subset, or the
#                          unresolved-source subset shrinking
#
# The L2 rates are scored against `label_blind` (a subset of the golden cases),
# a verdict reached from the source articles alone without reading the judge.
# `label_pass` is NOT scored: it mirrors judge_pass on every case.
#
# SCOPE: this makes no model calls. `judge_pass` is frozen in the fixture, so
# editing .claude/agents/coherence.md changes nothing here. The L2 numbers move
# when the golden set is re-judged and re-committed, not when the prompt changes.
#
# Runs under `uv` because the host python lacks the project's deps / version
# (mirrors bin/eval-judge / bin/trace's "no bare python3" convention).
#
# Usage:
#   bin/eval-regression            Compare current metrics vs baseline; exit 1 on regression
#   bin/eval-regression --update   Rewrite the baseline from current metrics (after an intended change)
#
# Fixtures (committed):
#   baseline    newsroom/tests/fixtures/eval_baseline.json
#   golden set  newsroom/tests/fixtures/coherence_golden.json
#   selections  newsroom/tests/fixtures/prod_baseline_selections.json

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

MODE="${1:-check}"

cd "$PROJECT_DIR/newsroom"

PROJECT_DIR="$PROJECT_DIR" MODE="$MODE" uv run python - <<'PY'
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd() / "src"))

from eval_regression import (  # noqa: E402
    FixtureError,
    compare_for_gate,
    compute_metrics_for_gate,
    load_json_for_gate,
)

proj = Path(os.environ["PROJECT_DIR"])
mode = os.environ["MODE"]

baseline_path = proj / "newsroom" / "tests" / "fixtures" / "eval_baseline.json"
golden_path = proj / "newsroom" / "tests" / "fixtures" / "coherence_golden.json"
selections_path = proj / "newsroom" / "tests" / "fixtures" / "prod_baseline_selections.json"

GREEN, RED, YELLOW, DIM, BOLD, RESET = (
    "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[1m", "\033[0m"
)


def color(s, code):
    return f"{code}{s}{RESET}" if sys.stdout.isatty() else s


def status_label(passed):
    # Tri-state: True -> PASS, False -> FAIL, None -> absent ("----").
    if passed is None:
        return "----"
    return "PASS" if passed else "FAIL"


for label, path in (("golden set", golden_path), ("selections fixture", selections_path)):
    if not path.exists():
        print(color(f"{label} fixture missing: {path}", RED), file=sys.stderr)
        print("the gate needs its committed fixtures; check the path or restore the file", file=sys.stderr)
        sys.exit(2)

def fixture_problem(exc):
    # Exit 2, not 1: a broken instrument is not a regression, and a caller must
    # be able to tell them apart. Policy pinned by the FixtureError tests.
    print(color(str(exc), RED), file=sys.stderr)
    print("this is a fixture/baseline problem, not a regression. Confirm the", file=sys.stderr)
    print("fixtures are good AND the gate itself is unmodified -- a bug in", file=sys.stderr)
    print("compare() lands here too -- then: bin/eval-regression --update", file=sys.stderr)
    sys.exit(2)


try:
    current = compute_metrics_for_gate(golden_path, selections_path)
except FixtureError as exc:
    fixture_problem(exc)

if mode == "--update":
    try:
        baseline = load_json_for_gate(baseline_path) if baseline_path.exists() else {}
    except FixtureError as exc:
        # --update reads the old baseline ONLY to carry _meta forward, so refusing
        # here would make the recovery this tool prints impossible; rm would be the
        # undocumented remedy. Regenerate, and be loud about the prose that is lost.
        print(color(f"{exc}", YELLOW), file=sys.stderr)
        print("regenerating anyway -- the _meta prose in it is LOST, rewrite it", file=sys.stderr)
        baseline = {}
    meta = baseline.get("_meta", {})
    out = {"_meta": meta, **current}
    baseline_path.write_text(json.dumps(out, indent=2) + "\n", encoding="utf-8")
    print(color(f"baseline updated: {baseline_path.relative_to(proj)}", BOLD))
    sys.exit(0)

if not baseline_path.exists():
    print(color(f"baseline missing: {baseline_path}", RED), file=sys.stderr)
    print("run: bin/eval-regression --update", file=sys.stderr)
    sys.exit(2)

try:
    baseline = load_json_for_gate(baseline_path)
    result = compare_for_gate(baseline, current)
except FixtureError as exc:
    fixture_problem(exc)

print(color("Eval-floor regression gate", BOLD))
print()

# L1 diff (per check, both fixtures).
for fixture in ("l1_golden_headlines", "l1_selections_fixture"):
    print(color(fixture, BOLD))
    if fixture == "l1_golden_headlines":
        # Without this the ten PASS rows below carry no denominator, and a
        # projection emptied to zero stories looks like a clean sweep.
        b_n, c_n = baseline["l1_golden_stories"], current["l1_golden_stories"]
        arrow = "" if b_n == c_n else color(f"  (baseline {b_n})", YELLOW)
        print(f"  {'graded stories':<26} {c_n}{arrow}")
    base = baseline[fixture]
    cur = current[fixture]
    for check in sorted(set(base) | set(cur)):
        b = base.get(check)
        c = cur.get(check)
        regressed = b and not c
        if regressed:
            mark_color = RED
        elif c:
            mark_color = GREEN
        else:
            mark_color = DIM
        mark = color(status_label(c), mark_color)
        arrow = "" if b == c else color(f"  (was {status_label(b)})", YELLOW)
        print(f"  {check:<26} {mark}{arrow}")
    print()

# L2 diff.
print(color("l2_judge_agreement", BOLD))
bl = baseline["l2_judge_agreement"]
cl = current["l2_judge_agreement"]


def fmt(v):
    return "n/a" if v is None else (f"{v:.4f}" if isinstance(v, float) else str(v))


for key in (
    "total_cases",
    "blind_labeled_cases",
    "agreement_rate",
    "fail_precision",
    "leak_count",
    "unresolved_sources",
    "unresolved_sources_passed",
):
    b, c = bl.get(key), cl.get(key)
    same = b == c
    line = f"  {key:<25} {fmt(c)}"
    if not same:
        line += color(f"  (baseline {fmt(b)})", YELLOW)
    print(line)
print()

if result.notes:
    print(color("notes (non-fatal):", DIM))
    for n in result.notes:
        print(color(f"  - {n}", DIM))
    print()

if result.passed:
    print(color("PASS -- no regressions vs baseline", GREEN))
    sys.exit(0)

print(color("FAIL -- regressions detected:", RED))
for r in result.regressions:
    print(color(f"  - {r}", RED))
sys.exit(1)
PY
