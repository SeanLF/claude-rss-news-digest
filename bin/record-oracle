#!/bin/bash
# The Python record as the TypeScript record's oracle: bin/render-oracle's renders of each run, plus
# web.archive.html beside each web.html, db.prepare_for_web's web copy of it. Then the parity test,
# which records the runs' tail into a COPY of DB and compares it row by row with the Python's rows.
#
# Usage:
#   bin/record-oracle 300 301 302 303 304   (the runs the parity test holds)
#   DB=path/to/snapshot.db             (default data/digest.db; mounted read-only, never written)
#   OUT=dir                            (default data/replay/oracle)
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

[[ $# -ge 1 ]] || { sed -n '2,9p' "$0"; exit 2; }
DB="${DB:-data/digest.db}"
export DB="$(cd "$(dirname "$DB")" && pwd)/$(basename "$DB")" OUT="${OUT:-data/replay/oracle}"
bin/render-oracle "$@"
OUT="$(cd "$OUT" && pwd)"
IMAGE="$(docker compose config --images digest-newsroom)"
dirs=()
for run in "$@"; do dirs+=("/out/run$run-prod"); done
docker run --rm -v "$(pwd)/newsroom/src:/app/src:ro" -v "$(pwd)/newsroom/tools:/app/tools:ro" -v "$OUT:/out" \
  -e PYTHONPATH=/app/src --entrypoint /app/.venv/bin/python3 "$IMAGE" /app/tools/web_archive_oracle.py "${dirs[@]}"
cd digest
RECORD_ORACLE_DB="$DB" RENDER_ORACLE="$OUT" \
  npx vitest run src/activities/record.parity.test.ts
