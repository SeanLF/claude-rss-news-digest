#!/bin/bash
# Print a run's archived trace (its current artifacts) from the local clone of the product
# database (bin/db-clone fills it; bin/psql reaches it), read-only.
#
# Usage:
#   bin/trace RUN_ID [ARTIFACT_NAME]   Print all artifacts (or one) for a run
#   bin/trace --list                   List runs that have archived trace

set -euo pipefail

PSQL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/psql"
export PGOPTIONS="-c default_transaction_read_only=on"
q() { "$PSQL" -q -v ON_ERROR_STOP=1 -A -t "$@" -f -; }

if [ -z "${1:-}" ]; then
  echo "Usage: bin/trace RUN_ID [ARTIFACT_NAME] | bin/trace --list" >&2
  exit 1
fi

if [ "$1" = "--list" ]; then
  out=$(q -P footer=off <<'SQL'
SELECT lpad(run_id::text, 7) || '  ' || lpad(count(*)::text, 9) || '  ' || to_char(min(created_at) AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')
FROM artifacts WHERE status = 'current' GROUP BY run_id ORDER BY run_id DESC;
SQL
)
  if [ -z "$out" ]; then echo "No archived trace yet."; exit 0; fi
  printf '%7s  %9s  %s\n' run_id artifacts archived_at
  printf '%s\n' "$out"
  exit 0
fi

run=$1
name=${2:-}
[[ "$run" =~ ^[0-9]+$ ]] || { echo "RUN_ID must be a number, got: $run" >&2; exit 1; }

# The name reaches SQL as a psql literal (:'name' is quoted and escaped by psql), never as SQL text.
names=$(q -v run="$run" <<'SQL'
SELECT name FROM artifacts WHERE run_id = :run AND status = 'current' ORDER BY name COLLATE "C";
SQL
)
if [ -z "$names" ]; then
  echo "No trace archived for run $run (try: bin/trace --list)"
  exit 1
fi

if [ -n "$name" ]; then
  if ! printf '%s\n' "$names" | grep -Fxq -- "$name"; then
    echo "Run $run has no artifact '$name'. Have: $(printf '%s\n' "$names" | paste -sd, - | sed 's/,/, /g')"
    exit 1
  fi
  q -v run="$run" -v name="$name" <<'SQL'
SELECT content FROM artifacts WHERE run_id = :run AND name = :'name' AND status = 'current';
SQL
  exit 0
fi

q -v run="$run" <<'SQL'
SELECT string_agg(format(E'===== run %s :: %s =====\n%s', run_id, name, content), E'\n\n' ORDER BY name COLLATE "C")
FROM artifacts WHERE run_id = :run AND status = 'current';
SQL
