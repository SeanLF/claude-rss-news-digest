#!/usr/bin/env bash
# usage: bin/import-legacy SRC DST_URL
#
# Imports a legacy SQLite digest.db into a FRESH Postgres database on the product schema
# (docs/2026-09-23-data-model-design.md §5.1), and verifies the copy before it keeps it. The digest
# image, with SRC mounted read-only, refuses a DST_URL that already holds tables and a WAL-mode SRC,
# copies SRC table for table into a `legacy` schema and holds that to the file's own fingerprint,
# builds the schema with dbmate, copies across in one transaction, checks every row against the
# legacy tables, and drops them (digest/src/cli/import-legacy.ts).
# SRC must not change while this runs: pass a snapshot (the online-backup copy the deploy takes),
# never the live file.
#
# Environment:
#   IMPORT_NETWORK  docker network from which DST_URL's host resolves (default: host)
#   DIGEST_IMAGE    an image built from digest/Dockerfile (default: built here, tagged digest-import:local)
set -euo pipefail
cd "$(dirname "$0")/.."
src=${1:?usage: bin/import-legacy SRC DST_URL}
dst=${2:?usage: bin/import-legacy SRC DST_URL}
net=${IMPORT_NETWORK:-host}
[ -r "$src" ] || { echo "import-legacy: cannot read $src" >&2; exit 2; }
src=$(cd "$(dirname "$src")" && pwd)/$(basename "$src")
# Only the file is mounted, so SQLite in the container would never see a journal beside it.
for side in -journal -wal; do
  [ ! -e "$src$side" ] || { echo "import-legacy: $src$side exists: $src is mid-write; import an online-backup snapshot" >&2; exit 2; }
done

image=${DIGEST_IMAGE:-}
if [ -z "$image" ]; then
  docker build -q -f digest/Dockerfile --build-arg GIT_SHA=import -t digest-import:local . >/dev/null
  image=digest-import:local
fi
start=$(date +%s)
docker run --rm --network "$net" -e DIGEST_DATABASE_URL="$dst" -v "$src:/src/legacy.db:ro" "$image" node dist/cli/import-legacy.js /src/legacy.db ||
  { echo "import-legacy: failed; drop $dst and create it empty before a retry" >&2; exit 1; }
echo "import-legacy: total $(( $(date +%s) - start )) s"
