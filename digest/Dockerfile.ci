FROM node:24-slim
# Temporal's test server is a cached download at test time; slim images ship no CA bundle.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/digest
COPY digest/package.json digest/package-lock.json ./
RUN npm ci
# The store's tests apply the repo's own migrations so the schema under test is production's.
COPY migrations/ /app/migrations/
COPY digest/ ./
