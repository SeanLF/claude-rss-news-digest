FROM node:26-slim
# Temporal's test server is a cached download at test time; slim images ship no CA bundle.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/digest
COPY digest/package.json digest/package-lock.json ./
RUN npm ci
# The store's tests apply the repo's own migrations so the schema under test is production's.
COPY migrations/ /app/migrations/
# The render's tests read the template, stylesheet and tokens, and the newsroom's kitchen-sink fixture.
COPY newsroom/templates/digest-template.html newsroom/templates/digest.css /app/newsroom/templates/
COPY newsroom/tests/fixtures/kitchensink_selections.json /app/newsroom/tests/fixtures/
COPY design/tokens.css /app/design/tokens.css
# python-tree.test.ts checks that what the worker images copy from newsroom/ exists and is in the runbook.
COPY newsroom/src/ /app/newsroom/src/
COPY docs/2026-09-23-temporal-cutover-runbook.md /app/docs/
COPY digest/ ./
