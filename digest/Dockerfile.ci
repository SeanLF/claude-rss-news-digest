FROM node:26-slim
# Temporal's test server is a cached download at test time; slim images ship no CA bundle.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/digest
COPY digest/package.json digest/package-lock.json ./
RUN npm ci
# The render's tests read the template, stylesheet and tokens, and the newsroom's kitchen-sink fixture.
COPY newsroom/templates/digest-template.html newsroom/templates/digest.css /app/newsroom/templates/
COPY newsroom/tests/fixtures/kitchensink_selections.json /app/newsroom/tests/fixtures/
COPY design/tokens.css /app/design/tokens.css
COPY digest/ ./
