{
  "name": "digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src",
    "test": "vitest run",
    "bundle:site": "esbuild src/site/main.ts --bundle --platform=node --format=esm --target=node26 --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=bundle/dist/site/main.js --metafile=bundle/meta.json --log-level=warning",
    "sbom:site": "node dist/cli/site-sbom.js package-lock.json bundle/meta.json bundle/site.cdx.json",
    "check-injections": "node dist/cli/check-injections.js",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-format JSON --output-file sbom.cdx.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@hono/node-server": "2.1.1",
    "@posthog/ai": "8.13.2",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "dbmate": "2.36.0",
    "entities": "8.1.0",
    "escape-goat": "4.0.0",
    "feedsmith": "3.0.0",
    "gnews-decoder": "0.1.0",
    "hono": "4.13.8",
    "lightningcss": "1.33.0",
    "mailchecker": "6.0.21",
    "ml-hclust": "4.0.0",
    "mrml": "1.6.1",
    "p-retry": "8.0.1",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "posthog-node": "5.54.1",
    "resend": "6.28.1",
    "turndown": "7.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mozilla/readability": "0.6.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/turndown": "5.0.6",
    "defuddle": "0.19.4",
    "dom-smoothie-js": "0.16.0",
    "esbuild": "0.28.2",
    "kysely": "0.29.6",
    "kysely-codegen": "0.20.0",
    "linkedom": "0.18.13",
    "markdown-it": "15.0.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "protobufjs": "8.8.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@swc/core@1.16.2": true,
    "protobufjs@7.6.6": true,
    "protobufjs@8.8.0": true,
    "@temporalio/core-bridge@1.24.0": true
  },
  "optionalDependencies": {
    "@dbmate/darwin-arm64": "2.36.0",
    "@dbmate/linux-arm64": "2.36.0",
    "@dbmate/linux-x64": "2.36.0",
    "@oxlint-tsgolint/darwin-arm64": "7.0.2002",
    "@oxlint-tsgolint/linux-arm64": "7.0.2002",
    "@oxlint-tsgolint/linux-x64": "7.0.2002",
    "@oxlint/binding-darwin-arm64": "1.85.0",
    "@oxlint/binding-linux-arm64-gnu": "1.85.0",
    "@oxlint/binding-linux-x64-gnu": "1.85.0",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
