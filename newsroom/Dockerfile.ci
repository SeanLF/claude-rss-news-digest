FROM python:3.14-slim

# Debian slim (glibc) base so scientific-Python deps install from manylinux wheels (Alpine/musl
# has no scikit-learn/scipy wheels for Python 3.14). Python 3.14 ships in the base image.
# uv floats on latest; a bad release fails this build, not prod.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/

WORKDIR /app

# Install app + dev deps in one layer (app deps needed for pytest imports)
COPY newsroom/pyproject.toml ./newsroom/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages \
    -r newsroom/pyproject.toml \
    ruff mypy bandit pytest
