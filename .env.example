# =============================================================================
# News Digest Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The dev stack (docker-compose.yml) reads CLAUDE_CODE_OAUTH_TOKEN from here, and DIGEST_NAME,
# SOURCE_URL, HOMEPAGE_URL and THREADS_* through compose's variable substitution; it sets its own
# fake Resend whatever this file says. bin/deploy reads REGISTRY and INFRA_DIR. Production's
# environment comes from terraform, not from this file, so the Resend and digest settings below
# only document what production sets.

# =============================================================================
# Claude Authentication (choose one)
# =============================================================================

# Claude subscription (Max/Pro). Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# =============================================================================
# Resend Settings (https://resend.com)
# =============================================================================
# Free tier: unlimited broadcasts to up to 1,000 contacts
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# To use your own domain:
# 1. Add domain in Resend dashboard
# 2. Add DNS records (DKIM, SPF)
# 3. Update RESEND_FROM=digest@yourdomain.com

# Resend Audience ID for broadcasts
# Create an audience at https://resend.com/audiences
# Then add contacts to manage recipients
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email for health alerts when RSS sources fail (optional)
# Leave empty to disable health alerts
HEALTH_ALERT_EMAIL=

# =============================================================================
# Digest Settings (optional)
# =============================================================================

# Display name for From header and email subject
DIGEST_NAME="News Digest"

# Domain for "View in browser" link
# Leave empty to disable the link
DIGEST_DOMAIN=

# GitHub repo URL for "Source code" link
# Leave empty to hide the link
SOURCE_URL=

# URL to past digests archive for "Past digests" link
ARCHIVE_URL=

# Author name and URL for footer attribution
# e.g., "Made by Sean" linking to your site
AUTHOR_NAME=
AUTHOR_URL=

# =============================================================================
# Evolving story-threads (on in the dev stack and in production)
# =============================================================================
# Track ongoing stories across days: a returning reader sees an "Ongoing - day N"
# badge and a "what's new today" delta instead of a re-described summary. Adds a
# Haiku linker + per-thread synthesis (~$0.20-0.25/run).
# THREADS_ENABLED=true

# Widen each thread's article set to its entity-soft neighbourhood before
# synthesis (+coverage, ~2x the thread cost). Only meaningful with THREADS_ENABLED.
# THREAD_LATEBIND=true

# Runs a thread can go unseen before it stops matching (raise to keep storylines
# that go quiet for a few days on the same thread).
# THREAD_DORMANT_AFTER=3

# =============================================================================
# Web Viewer Settings (optional)
# =============================================================================

# Homepage URL for footer link in web archive
HOMEPAGE_URL=

# =============================================================================
# Deployment (optional -- only needed for production infrastructure)
# =============================================================================

# Docker registry URL for pushing images
# REGISTRY=registry.domain.dev

# Path to infrastructure repo (for bin/deploy)
# INFRA_DIR=../seanfloyd-infra
